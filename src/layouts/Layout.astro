---
import '../styles/global.css';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
}

const {
    title = 'Memberley — Membership Software for Pool & Swim-Tennis Clubs',
    description = 'Memberley runs memberships, dues, reservations, classes, communications, and front-desk check-in for pool and swim-tennis clubs in one calm workspace. 45-day free trial, no card required.',
    image = '/og-image.png',
    imageAlt = 'Memberley ampersand logo with the line: Memberships, reservations, payments, and check-ins in one calm workspace.',
} = Astro.props;

const canonicalUrl = Astro.url.href;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;

// PostHog product analytics. The phc_* token is a public, client-side
// project key (safe to ship in static HTML); shares the same project as
// the memberley-app so marketing + product attribution flow into one funnel.
const POSTHOG_KEY =
    (import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined) ??
    'phc_t9M6hHhJTXq47HivttgUGRQSHki6LgggkMMukPrcFWco';
const POSTHOG_HOST =
    (import.meta.env.PUBLIC_POSTHOG_HOST as string | undefined) ??
    'https://us.i.posthog.com';

// Meta (Facebook) Pixel for Memberley ads. Same pixel ID as the memberley-app
// so marketing and product traffic land in one Events Manager funnel: ads point
// here, but signup finishes on app.memberley.com. The `_fbp`/`_fbc` cookies are
// scoped to the registrable domain, so click attribution survives that hop.
// A pixel ID is public by design (it only identifies the ad account's pixel).
const META_PIXEL_ID =
    (import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined) ??
    '1538904127970855';

// Google Ads tag (gtag.js) for conversion tracking on Memberley ad campaigns.
// A measurement/conversion ID is public by design — it identifies the Ads
// account's tag, not a credential. Loaded lazily so ad blockers and local dev
// can't break the page, and gated like the other trackers.
const GOOGLE_ADS_ID =
    (import.meta.env.PUBLIC_GOOGLE_ADS_ID as string | undefined) ??
    'AW-18393786799';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <script is:inline>
            // Enable scroll-reveal start states before first paint so revealed
            // elements never flash in. No-JS visitors keep everything visible.
            document.documentElement.classList.add('js-reveal');
        </script>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="canonical" href={canonicalUrl} />
        <meta name="theme-color" content="#faf9f7" />
        <meta name="application-name" content="Memberley" />
        <meta name="apple-mobile-web-app-title" content="Memberley" />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content="Memberley" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Besley:ital,wght@0,400..900;1,400..900&family=Geist:wght@300;400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <script
            is:inline
            define:vars={{ posthogKey: POSTHOG_KEY, posthogHost: POSTHOG_HOST }}
        >
            if (
                posthogKey &&
                window.location.hostname !== 'localhost' &&
                !window.location.hostname.endsWith('.test')
            ) {
                !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(/\/$/,"")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
                posthog.init(posthogKey, {
                    api_host: posthogHost,
                    capture_pageview: true,
                    capture_pageleave: true,
                    person_profiles: 'identified_only',
                });
            }
        </script>

        <!-- Meta Pixel Code -->
        <script is:inline define:vars={{ metaPixelId: META_PIXEL_ID }}>
            if (
                metaPixelId &&
                window.location.hostname !== 'localhost' &&
                !window.location.hostname.endsWith('.test')
            ) {
                !function(f,b,e,v,n,t,s)
                {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                n.callMethod.apply(n,arguments):n.queue.push(arguments)};
                if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
                n.queue=[];t=b.createElement(e);t.async=!0;
                t.src=v;s=b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t,s)}(window, document,'script',
                'https://connect.facebook.net/en_US/fbevents.js');
                fbq('init', metaPixelId);
                // Fired inline (unlike memberley-app, which defers to its Inertia
                // router): this is a static MPA, so every page is a real document
                // load and there are no client-side route changes to catch.
                fbq('track', 'PageView');

                // Lead = clicked through to signup. The signup CTAs are plain
                // links to app.memberley.com/register, so a delegated listener
                // covers every page without touching each CTA. Once per page
                // load; the header CTA rewrites itself to /dashboard for signed-in
                // visitors, which correctly stops matching.
                var leadFired = false;
                document.addEventListener('click', function (event) {
                    if (leadFired) {
                        return;
                    }

                    var link = event.target.closest && event.target.closest('a[href*="/register"]');

                    if (!link) {
                        return;
                    }

                    leadFired = true;
                    fbq('track', 'Lead');
                });
            }
        </script>
        <!-- End Meta Pixel Code -->

        <!-- Google tag (gtag.js) -->
        <script is:inline define:vars={{ googleAdsId: GOOGLE_ADS_ID }}>
            if (
                googleAdsId &&
                window.location.hostname !== 'localhost' &&
                !window.location.hostname.endsWith('.test')
            ) {
                window.dataLayer = window.dataLayer || [];
                window.gtag = function () {
                    window.dataLayer.push(arguments);
                };

                var gtagScript = document.createElement('script');
                gtagScript.async = true;
                gtagScript.src =
                    'https://www.googletagmanager.com/gtag/js?id=' +
                    encodeURIComponent(googleAdsId);
                document.head.appendChild(gtagScript);

                gtag('js', new Date());
                gtag('config', googleAdsId);
            }
        </script>
        <!-- End Google tag -->
    </head>
    <body class="bg-[#faf9f7] text-stone-900">
        <a href="#main" class="skip-link">Skip to content</a>
        <noscript
            ><img
                height="1"
                width="1"
                style="display:none"
                src={`https://www.facebook.com/tr?id=${encodeURIComponent(META_PIXEL_ID)}&ev=PageView&noscript=1`}
                alt=""
            /></noscript
        >
        <slot />
        <script is:inline>
            // One delegated event contract keeps CTA attribution consistent
            // across the homepage, comparison pages, and shared shell.
            document.addEventListener('click', function (event) {
                var target = event.target.closest && event.target.closest('[data-marketing-event]');

                if (!target) {
                    return;
                }

                var eventName = target.getAttribute('data-marketing-event');
                var location = target.getAttribute('data-marketing-location') || 'unknown';

                if (eventName && window.posthog && typeof window.posthog.capture === 'function') {
                    window.posthog.capture(eventName, {
                        location: location,
                        destination: target.getAttribute('href') || null,
                    });
                }
            });

            // Reveal motion remains progressive enhancement: content is visible
            // without JS, and reduced-motion visitors skip the transition.
            var revealItems = document.querySelectorAll('[data-reveal]');
            if ('IntersectionObserver' in window) {
                var revealObserver = new IntersectionObserver(function (entries, observer) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) {
                            return;
                        }

                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    });
                }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 });

                revealItems.forEach(function (item) {
                    revealObserver.observe(item);
                });
            } else {
                revealItems.forEach(function (item) {
                    item.classList.add('is-visible');
                });
            }
        </script>

        <!-- GhostChat widget -->
        <script
            is:inline
            src="https://api.ghostchat.dev/widget.js"
            data-site="cl95794ad5a98f4abda61f3c0a"
            defer></script>
    </body>
</html>
