---
const placeholderQuotes = [
  {
    quote:
      "We opened registration on Monday and, for the first time, nobody on the board had to babysit a spreadsheet.",
    name: "Club board member",
    context: "Neighborhood pool · placeholder",
  },
  {
    quote:
      "The gate team learned check-in before their first shift. The line kept moving, even on opening weekend.",
    name: "Operations lead",
    context: "Swim & tennis club · placeholder",
  },
  {
    quote:
      "Families can see what they owe, book a court, and update their household without emailing us first.",
    name: "Membership chair",
    context: "Community club · placeholder",
  },
];

const quotes = import.meta.env.DEV ? placeholderQuotes : [];
---

{
  quotes.length > 0 ? (
    <section
      aria-labelledby="testimonial-heading"
      data-placeholder-testimonials
      class="border-y border-amber-900/12 bg-amber-50/45"
    >
      <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-24">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <div class="font-mono text-[0.625rem] font-semibold tracking-[0.14em] text-amber-800 uppercase">
              Layout preview · not customer endorsements
            </div>
            <h2
              id="testimonial-heading"
              class="mt-4 max-w-[18ch] font-serif text-[clamp(2rem,4vw,3.2rem)] leading-[1.03] font-semibold tracking-[-0.04em] text-stone-950"
            >
              What a calmer season should feel like.
            </h2>
          </div>
          <p class="max-w-[42ch] text-[0.8125rem] leading-relaxed text-stone-500">
            These three quotes are intentionally labeled placeholders and are
            excluded from production builds until verified customer quotes replace them.
          </p>
        </div>

        <div class="mt-10 grid gap-3 lg:grid-cols-3">
          {quotes.map((item, index) => (
            <figure
              data-reveal
              style={`--reveal-delay:${index * 70}ms`}
              class="flex min-h-[15rem] flex-col justify-between rounded-[1.15rem] border border-stone-950/9 bg-white p-6 shadow-paper"
            >
              <blockquote class="font-serif text-[1.25rem] leading-[1.42] tracking-[-0.02em] text-stone-800">
                “{item.quote}”
              </blockquote>
              <figcaption class="mt-8 border-t border-stone-950/8 pt-4">
                <span class="block text-[0.8125rem] font-semibold text-stone-800">
                  {item.name}
                </span>
                <span class="mt-1 block font-mono text-[0.625rem] tracking-[0.08em] text-stone-400 uppercase">
                  {item.context}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section aria-label="Memberley commitments" class="border-y border-stone-950/8 bg-white/65">
      <div class="mx-auto grid max-w-[74rem] gap-6 px-5 py-8 text-center sm:grid-cols-3 sm:px-7 lg:px-8">
        {[
          "45 days free · no card",
          "Free roster migration",
          "A real person when you need help",
        ].map((item) => (
          <div class="font-mono text-[0.6875rem] font-medium tracking-[0.08em] text-stone-500 uppercase">
            {item}
          </div>
        ))}
      </div>
    </section>
  )
}
