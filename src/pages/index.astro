---
import Layout from "../layouts/Layout.astro";

declare const process: {
  env: {
    NODE_TLS_REJECT_UNAUTHORIZED?: string;
  };
};

const fromEnv = (import.meta.env.PUBLIC_MEMBERLEY_APP_URL as string | undefined)
  ?.trim()
  .replace(/\/$/, "");
const APP_URL =
  fromEnv && fromEnv.length > 0
    ? fromEnv
    : import.meta.env.DEV
      ? "http://memberley-app.test"
      : "https://app.memberley.com";
const SIGNUP_URL = `${APP_URL}/register`;
const LOGIN_URL = `${APP_URL}/login`;

// ── Plans ──────────────────────────────────────────────────────────────────
// Pricing data is sourced from the app's public /api/v1/plans endpoint at
// build time so prices and limits stay in sync. Marketing-only flair
// (featured flag, CTA copy, extra differentiator bullets) is layered on top
// via the lookup below, keyed by plan slug.

type ApiPlan = {
  id: number;
  slug: string;
  name: string;
  description: string | null;
  price_cents: number;
  price_formatted: string;
  trial_days: number;
  platform_fee_percentage: number;
  limits: {
    max_users: number | null;
    max_facilities: number | null;
    max_staff_users: number | null;
    max_membership_tiers: number | null;
    max_guests: number | null;
  };
  capabilities: {
    facility_reservations: boolean;
    checkins: boolean;
    waitlist: boolean;
    payments_and_billing: boolean;
    activity_log: boolean;
    public_registration: boolean;
  };
};

type MarketingPlan = {
  slug: string;
  name: string;
  price: string;
  featured: boolean;
  cta: string;
  feats: string[];
  platformFeePercentage: number;
};

function formatPercent(value: number): string {
  return Number.isInteger(value)
    ? `${value}%`
    : `${value.toFixed(2).replace(/\.?0+$/, "")}%`;
}

function feeLabel(value: number): string {
  return value > 0
    ? `${formatPercent(value)} per payment`
    : "No platform fees!";
}

const marketingMeta: Record<
  string,
  { featured: boolean; cta: string; extraFeats: string[] }
> = {
  starter: {
    featured: false,
    cta: "Start free trial",
    extraFeats: ["Tiers & billing", "Email notifications"],
  },
  growth: {
    featured: true,
    cta: "Start free trial",
    extraFeats: ["Guest passes", "Priority support"],
  },
  community: {
    featured: false,
    cta: "Start free trial",
    extraFeats: [
      "Embedded member portal",
      "White-label branding",
      "Custom onboarding",
      "Dedicated support",
    ],
  },
};

const fallbackPlans: MarketingPlan[] = [
  {
    slug: "starter",
    name: "Starter",
    price: "$29",
    featured: false,
    cta: "Start free trial",
    feats: [
      "Up to 100 members",
      "1 facility",
      "Tiers & billing",
      "Email notifications",
    ],
    platformFeePercentage: 3,
  },
  {
    slug: "growth",
    name: "Growth",
    price: "$79",
    featured: true,
    cta: "Start free trial",
    feats: [
      "Up to 500 members",
      "5 facilities",
      "Reservations & check-ins",
      "Waitlist automation",
      "Guest passes",
      "Priority support",
    ],
    platformFeePercentage: 2,
  },
  {
    slug: "community",
    name: "Community",
    price: "$199",
    featured: false,
    cta: "Start free trial",
    feats: [
      "Unlimited members",
      "Unlimited facilities",
      "Embedded member portal",
      "White-label branding",
      "Custom onboarding",
      "Dedicated support",
      "SSO & audit exports",
    ],
    platformFeePercentage: 0,
  },
];

function buildFeats(plan: ApiPlan, extra: string[]): string[] {
  const memberLimit = plan.limits.max_users;
  const facilityLimit = plan.limits.max_facilities;

  const feats: string[] = [];

  feats.push(
    memberLimit === null
      ? "Unlimited members"
      : `Up to ${memberLimit.toLocaleString()} members`,
  );
  feats.push(
    facilityLimit === null
      ? "Unlimited facilities"
      : `${facilityLimit} ${facilityLimit === 1 ? "facility" : "facilities"}`,
  );

  if (plan.capabilities.facility_reservations && plan.capabilities.checkins) {
    feats.push("Reservations & check-ins");
  }
  if (plan.capabilities.waitlist) {
    feats.push("Waitlist automation");
  }
  if (plan.capabilities.activity_log) {
    feats.push("Activity log & exports");
  }
  if (plan.capabilities.public_registration) {
    feats.push("Public registration");
  }

  return [...feats, ...extra];
}

let plans: MarketingPlan[] = fallbackPlans;

// Herd serves *.test on a self-signed cert; relax TLS verification only when
// targeting a local Herd URL so devs can preview live pricing during build.
const previousTlsReject = process.env.NODE_TLS_REJECT_UNAUTHORIZED;
const isLocalHerd = APP_URL.includes(".test");
if (isLocalHerd) {
  process.env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
}

try {
  const res = await fetch(`${APP_URL}/api/v1/plans`, {
    headers: { Accept: "application/json" },
  });
  if (res.ok) {
    const json = (await res.json()) as { data: ApiPlan[] };
    plans = json.data.map((p): MarketingPlan => {
      const meta = marketingMeta[p.slug] ?? {
        featured: false,
        cta: "Start free trial",
        extraFeats: [],
      };
      return {
        slug: p.slug,
        name: p.name,
        price: p.price_formatted,
        featured: meta.featured,
        cta: meta.cta,
        feats: buildFeats(p, meta.extraFeats),
        platformFeePercentage: Number(p.platform_fee_percentage ?? 0),
      };
    });
  } else {
    console.warn(`Plans API returned ${res.status}; using fallback pricing.`);
  }
} catch (err) {
  console.warn("Plans API fetch failed; using fallback pricing.", err);
} finally {
  if (isLocalHerd) {
    if (previousTlsReject === undefined) {
      delete process.env.NODE_TLS_REJECT_UNAUTHORIZED;
    } else {
      process.env.NODE_TLS_REJECT_UNAUTHORIZED = previousTlsReject;
    }
  }
}

