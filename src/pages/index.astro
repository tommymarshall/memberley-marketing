            How Memberley stacks up.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            Built for neighborhood pools and community swim clubs — so the
            comparison that matters is against the tools you&rsquo;ve already
            tried.
          </p>
        </div>

        <!-- Comparison table -->
        <div class="overflow-x-auto rounded-lg border border-stone-300 bg-white">
          <table class="w-full min-w-[46rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-stone-300 bg-stone-100">
                <th class="w-[32%] p-4"></th>
                {
                  compareColumns.map((c, i) => (
                    <th
                      class={`p-4 text-center ${i === 0 ? "bg-amber-700/[0.06]" : ""}`}
                    >
                      <img
                        src={c.logo}
                        alt={c.name}
                        class={`mx-auto block h-6 w-auto object-contain ${c.isOwn ? "" : "opacity-60 grayscale"}`}
                        loading="lazy"
                        decoding="async"
                      />
                      <span
                        class={`mt-2 block text-[0.6875rem] font-semibold tracking-wide ${i === 0 ? "text-amber-800" : "text-stone-600"}`}
                      >
                        {c.name}
                      </span>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                compareRows.map((row) => (
                  <tr class="border-b border-stone-200 last:border-0">
                    <th class="p-4 align-middle text-[0.8125rem] font-medium text-stone-700">
                      {row.label}
                    </th>
                    {row.cells.map((cell, i) => (
                      <td
                        class={`p-4 text-center align-middle ${i === 0 ? "bg-amber-700/[0.04]" : ""}`}
                      >
                        {typeof cell === "string" ? (
                          <span class="text-[0.8125rem] text-stone-700">
                            {cell}
                          </span>
                        ) : cell === true ? (
                          <svg
                            class="mx-auto size-4 text-amber-700"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-label="Yes"
                          >
                            <path
                              d="M3 8.3l3 3 7-7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : cell === false ? (
                          <span class="text-[0.875rem] text-stone-400" aria-label="No">
                            ✕
                          </span>
                        ) : (
                          <span
                            class="text-stone-300"
                            aria-label="Not offered"
                          >
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-4 font-mono text-[0.6875rem] tracking-wide text-stone-500">
          * Competitor pricing &amp; features as published on their own sites
          (2026).
        </p>

        <!-- Why clubs switch -->
        <div
          class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-stone-300 bg-stone-300 md:grid-cols-3"
        >
          {
            switchCards.map((c) => (
              <div class="flex flex-col bg-stone-50 p-8">
                <div class="font-mono text-[0.6875rem] tracking-wide text-stone-500 uppercase">
                  Switching from
