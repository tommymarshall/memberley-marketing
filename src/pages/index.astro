  <script is:inline>
    (function () {
      // Gentle scroll-in reveals; show everything if IO is unsupported.
      var reveals = document.querySelectorAll("[data-reveal]");
      if (!reveals.length) return;
      if (!("IntersectionObserver" in window)) {
        reveals.forEach(function (el) {
          el.classList.add("is-visible");
        });
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
      );
      reveals.forEach(function (el) {
        io.observe(el);
      });

      // Anchor navigation should never land on invisible content: reveal the
      // target section immediately instead of waiting for the observer.
      var revealHashTarget = function () {
        var id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        var target = document.getElementById(id);
        if (!target) return;
        var els = target.querySelectorAll("[data-reveal]");
        els.forEach(function (el) {
          el.classList.add("is-visible");
          io.unobserve(el);
        });
        if (target.hasAttribute("data-reveal")) {
          target.classList.add("is-visible");
          io.unobserve(target);
        }
      };
      window.addEventListener("hashchange", revealHashTarget);
      revealHashTarget();
    })();
  </script>
