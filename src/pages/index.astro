                  height="24"
                  class="size-6"
                  loading="lazy"
                  decoding="async"
                />
                <span
                  class="font-mono text-[0.75rem] tracking-wide text-stone-400 uppercase"
                >
                  Create organization
                </span>
              </span>
              <span
                class="rounded-sm bg-amber-400/15 px-2 py-0.5 font-mono text-[0.625rem] font-medium tracking-wide text-amber-400 uppercase"
              >
                Free trial
              </span>
            </div>

            <p class="mb-8 text-[0.875rem] leading-relaxed text-stone-400">
              Get started in under a minute — we&rsquo;ll walk you through
              organization setup, tiers, and your first signup link.
            </p>

            <a
              href={SIGNUP_URL}
              class="block w-full rounded-sm bg-amber-700 py-3 text-center text-[0.875rem] font-semibold text-white transition hover:bg-amber-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
            >
              Create my organization →
            </a>

            <p class="mt-6 text-center font-mono text-[0.75rem] text-stone-500">
              Already have an account?{" "}
              <a href={LOGIN_URL} class="text-amber-400 hover:text-amber-300">
                sign in
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <footer class="border-t border-stone-300 bg-stone-50">
      <div
        class="mx-auto flex max-w-[80rem] items-center justify-between px-6 py-6 text-[0.75rem] text-stone-600 lg:px-8"
      >
        <span>© 2026 Memberley, Inc.</span>
        <a href="/terms" class="transition hover:text-stone-900">Terms of use</a
        >
      </div>
    </footer>
  </div>

  <script is:inline define:vars={{ appUrl: APP_URL }}>
    (function () {
      function applyAuthenticatedNav() {
        var signin = document.getElementById("nav-signin");
        var cta = document.getElementById("nav-cta");
        if (!signin || !cta || window.__ML_AUTHENTICATED !== true) {
          return;
        }
        signin.remove();
        cta.textContent = "Dashboard";
        cta.setAttribute("href", appUrl + "/dashboard");
      }

      window.__ML_AUTHENTICATED = false;
      var probe = document.createElement("script");
      probe.src = appUrl + "/marketing/session.js";
      probe.async = true;
      probe.onload = applyAuthenticatedNav;
      probe.onerror = function () {};
      document.head.appendChild(probe);
    })();
  </script>
</Layout>
