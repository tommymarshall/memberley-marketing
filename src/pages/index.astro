                    {p.feats.map((f) => (
                      <li class="flex items-start gap-2.5 text-[0.875rem] text-stone-600">
                        <svg
                          class="mt-0.5 size-4 h-lh shrink-0 text-amber-700"
                          viewBox="0 0 16 16"
                          fill="none"
                        >
                          <path
                            d="M3 8.3l3 3 7-7"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
