    <!-- Pricing -->
    <section id="pricing" class="border-b border-stone-300 bg-stone-50">
      <div class="mx-auto max-w-[80rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[48ch]">
          <div class={eyebrow}>§ Pricing</div>
          <h2
