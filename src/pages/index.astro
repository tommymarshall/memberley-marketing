---
import Layout from '../layouts/Layout.astro';

// ── Beta launch page ──────────────────────────────────────────────────────
// Temporary landing for early-access signups. The form POSTs cross-origin
// to the Laravel app (app.memberley.com), which forwards to Resend's
// Contacts API. Marketing site stays fully static.

const fromEnv = (import.meta.env.PUBLIC_MEMBERLEY_APP_URL as string | undefined)
    ?.trim()
    .replace(/\/$/, '');
const APP_URL =
    fromEnv && fromEnv.length > 0
        ? fromEnv
        : import.meta.env.DEV
          ? 'http://memberley-app.test'
          : 'https://app.memberley.com';
const SIGNUP_ENDPOINT = `${APP_URL}/api/v1/marketing/beta-signup`;

const eyebrow =
    'font-mono text-[0.6875rem] font-medium tracking-wide text-amber-800 uppercase';
const display = 'font-serif font-semibold tracking-tight';

const features = [
    {
        n: '01',
        title: 'Memberships & tiers',
        desc: 'Pricing, renewals, autopay, invite codes, and waitlists with auto-promotion.',
        status: 'Live',
    },
    {
        n: '02',
        title: 'Reservations & facilities',
        desc: 'Courts, lanes, and rooms with operating hours, seasons, and admin approvals.',
        status: 'Live',
    },
    {
        n: '03',
        title: 'Stripe Connect payments',
        desc: 'Members pay you directly. Funds land in your bank the next business day.',
        status: 'Live',
    },
    {
        n: '04',
        title: 'Front-desk check-ins',
        desc: 'QR codes, guest pass deductions, and a daily ops view that just works.',
        status: 'Live',
    },
    {
        n: '05',
        title: 'Classes & programs',
        desc: 'Offerings catalog, sessions, public signup pages, and enrollment management.',
        status: 'Live',
    },
    {
        n: '06',
        title: 'Email campaigns',
        desc: 'Build dynamic segments, send broadcasts, track opens, deliveries, and bounces.',
        status: 'Live',
    },
    {
        n: '07',
        title: 'SMS member comms',
        desc: 'Broadcasts and one-to-one texts without juggling a second tool.',
        status: 'Live',
    },
    {
        n: '08',
        title: 'Family accounts',
        desc: 'Households under one roof — linked members, shared billing, clean passes.',
        status: 'Live',
    },
    {
        n: '09',
        title: 'Waivers & documents',
        desc: 'E-sign reusable waiver templates, share document libraries, export PDFs.',
        status: 'Live',
    },
];

const orgTypes = ['Swim club', 'HOA', 'Private club', 'Other'];

const title = 'Memberley — Join the beta';
const description =
    'Get early access to Memberley, the calm membership workspace for community organizations.';
---

<Layout title={title} description={description}>
    <div class="min-h-dvh bg-stone-50 font-sans text-stone-900 antialiased">
        <header
            class="border-b border-stone-300 bg-stone-50/90 backdrop-blur-sm"
        >
            <div
                class="mx-auto flex h-14 max-w-[80rem] items-center justify-between px-6 lg:px-8"
            >
                <a
                    href="/"
                    aria-label="Homepage"
                    class="flex items-center gap-2"
                >
                    <img
                        src="/memberley-amper-light.svg"
                        alt=""
                        width="24"
                        height="24"
                        class="size-6"
                        loading="eager"
                        decoding="async"
                    />
                    <span
                        class="text-[0.9375rem] font-semibold tracking-tight"
                        >Memberley</span
                    >
                    <span
                        class="ml-2 rounded-sm border border-stone-300 px-1.5 py-0.5 font-mono text-[0.625rem] text-stone-600"
                        >Beta</span
                    >
                </a>
                <a
                    href="#signup"
                    class="text-[0.8125rem] text-stone-600 transition hover:text-stone-900"
                    >Request access ↓</a
                >
            </div>
        </header>

        <main class="border-b border-stone-300">
            <div
                class="mx-auto grid max-w-[80rem] grid-cols-1 gap-16 px-6 pt-14 pb-24 lg:grid-cols-12 lg:px-8 lg:pt-20 lg:pb-32"
            >
                <!-- Left: copy + form -->
                <div class="lg:col-span-7" id="signup">
                    <div
                        class="mb-8 inline-flex items-center gap-2 rounded-full border border-stone-300 bg-stone-100 py-1 pr-3 pl-1"
                    >
                        <span
                            class="flex items-center gap-1.5 rounded-full bg-amber-700 px-2 py-0.5 text-[0.625rem] font-medium tracking-wide text-white uppercase"
                        >
                            <span class="size-1.5 rounded-full bg-white"
                            ></span>
                            Beta
                        </span>
                        <span class="text-[0.75rem] text-stone-700">
                            Early access opens this season →
                        </span>
                    </div>

                    <h1
                        class={`max-w-[20ch] text-[clamp(2.75rem,6vw,5rem)] leading-[0.95] text-balance ${display} text-stone-900`}
                    >
                        Run your community like it runs itself.
                    </h1>

                    <p
                        class="mt-8 max-w-[52ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
                    >
                        Memberships, reservations, payments, classes, comms,
                        and front-desk check-ins — in one calm workspace. Get
                        early access while we open the doors to more clubs.
                    </p>

                    <form
                        class="beta-form mt-10 max-w-[34rem]"
                        novalidate
                    >
                        <div
                            class="flex flex-col gap-3 sm:flex-row sm:items-center"
                        >
                            <div class="flex-1">
                                <label for="email" class="sr-only"
                                    >Email address</label
                                >
                                <input
                                    id="email"
                                    type="email"
                                    name="email"
                                    required
                                    autocomplete="email"
                                    placeholder="you@yourclub.org"
                                    class="w-full rounded-sm border border-stone-300 bg-white px-4 py-3 text-[0.9375rem] text-stone-900 placeholder:text-stone-400 transition focus:border-stone-900 focus:outline-none"
                                />
                            </div>
                            <button
                                type="submit"
                                class="group inline-flex items-center justify-center gap-2 rounded-sm bg-stone-900 px-6 py-3 text-[0.875rem] font-medium text-stone-50 transition hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
                            >
                                <span data-form-label>Join the beta</span>
                                <span
                                    class="transition group-hover:translate-x-0.5"
                                    aria-hidden="true">→</span
                                >
                            </button>
                        </div>

                        <fieldset class="mt-5">
                            <legend class={`${eyebrow} mb-3`}>I run a</legend>
                            <div class="flex flex-wrap gap-2">
                                {
                                    orgTypes.map((t) => (
                                        <label class="cursor-pointer">
                                            <input
                                                type="radio"
                                                name="org_type"
                                                value={t}
                                                class="peer sr-only"
                                            />
                                            <span class="inline-block rounded-full border border-stone-300 bg-white px-3 py-1 text-[0.75rem] text-stone-700 transition hover:border-stone-400 peer-checked:border-stone-900 peer-checked:bg-stone-900 peer-checked:text-stone-50">
                                                {t}
                                            </span>
                                        </label>
                                    ))
                                }
                            </div>
                        </fieldset>

                        <p
                            class="mt-5 font-mono text-[0.75rem] text-stone-500"
                            data-form-status
                        >
                            One email when your invite is ready. No spam, ever.
                        </p>
                    </form>
                </div>

                <!-- Right: feature panel styled like the homepage activity log -->
                <div class="lg:col-span-5">
                    <div
                        class="flex max-h-[calc(100dvh-8rem)] flex-col overflow-hidden rounded-lg border border-stone-300 bg-white lg:sticky lg:top-20"
                    >
                        <div
                            class="flex shrink-0 items-center justify-between border-b border-stone-300 bg-stone-100 px-4 py-2.5"
                        >
                            <span
                                class="font-mono text-[0.6875rem] font-medium tracking-wide text-stone-900 uppercase"
                                >In the box</span
                            >
                            <span
                                class="font-mono text-[0.625rem] text-stone-500"
                                >v1.0 · Beta</span
                            >
                        </div>
                        <ul role="list" class="flex-1 divide-y divide-stone-300 overflow-y-auto">
                            {
                                features.map((f) => (
                                    <li class="flex items-start justify-between gap-4 px-5 py-4">
                                        <div class="min-w-0">
                                            <div class="font-mono text-[0.625rem] font-medium tracking-wide text-amber-800 uppercase">
                                                {f.n} · {f.title}
                                            </div>
                                            <div class="mt-1 text-[0.8125rem] leading-relaxed text-stone-600">
                                                {f.desc}
                                            </div>
                                        </div>
                                        <span
                                            class={`shrink-0 rounded-sm border px-1.5 py-0.5 font-mono text-[0.625rem] tracking-wide uppercase ${f.status === 'Live' ? 'border-amber-700/30 bg-amber-700/10 text-amber-800' : f.status === 'Beta' ? 'border-stone-300 bg-stone-100 text-stone-700' : 'border-stone-300 bg-white text-stone-500'}`}
                                        >
                                            {f.status}
                                        </span>
                                    </li>
                                ))
                            }
                        </ul>
                        <div
                            class="flex shrink-0 items-center justify-between border-t border-stone-300 bg-stone-100 px-4 py-2 text-[0.75rem]"
                        >
                            <span
                                class="flex items-center gap-1.5 font-mono text-stone-600"
                            >
                                <span
                                    class="size-1.5 rounded-full bg-amber-600"
                                ></span>
                                Shipping weekly
                            </span>
                            <span class="font-mono text-stone-500"
                                >9 modules</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="border-t border-stone-300 bg-stone-50">
            <div
                class="mx-auto max-w-[80rem] px-6 py-6 text-[0.75rem] text-stone-600 lg:px-8"
            >
                © 2026 Memberley, Inc. · Beta launch
            </div>
        </footer>
    </div>

    <!-- Form behavior — progressive enhancement -->
    <script is:inline define:vars={{ endpoint: SIGNUP_ENDPOINT }}>
        (function () {
            var form = document.querySelector('form.beta-form');
            if (!form) return;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                var btn = form.querySelector('button[type="submit"]');
                var label = form.querySelector('[data-form-label]');
                var status = form.querySelector('[data-form-status]');
                var emailInput = form.querySelector('input[name="email"]');
                var orgInput = form.querySelector(
                    'input[name="org_type"]:checked',
                );

                if (!emailInput || !emailInput.value.trim()) return;

                var originalLabel = label ? label.textContent : '';
                if (label) label.textContent = 'Sending…';
                if (btn) btn.disabled = true;
                if (status) {
                    status.textContent = '';
                    status.classList.remove('text-red-700');
                    status.classList.add('text-stone-500');
                }

                try {
                    var res = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: emailInput.value.trim(),
                            org_type: orgInput ? orgInput.value : null,
                        }),
                    });
                    var data = await res.json().catch(function () {
                        return {};
                    });

                    if (!res.ok) {
                        throw new Error(
                            data && data.error
                                ? data.error
                                : 'Something went wrong.',
                        );
                    }

                    var safeEmail = emailInput.value
                        .trim()
                        .replace(/[<>&]/g, '');
                    form.innerHTML =
                        '<div class="rounded-sm border border-stone-300 bg-stone-100 px-5 py-6"><div class="font-mono text-[0.625rem] font-medium tracking-wide text-amber-800 uppercase">You\u2019re on the list</div><div class="mt-2 text-[0.9375rem] text-stone-700">We\u2019ll email <strong>' +
                        safeEmail +
                        '</strong> as soon as a seat opens.</div></div>';
                } catch (err) {
                    if (label) label.textContent = originalLabel;
                    if (btn) btn.disabled = false;
                    if (status) {
                        status.textContent =
                            (err && err.message) ||
                            'Something went wrong. Please try again.';
                        status.classList.remove('text-stone-500');
                        status.classList.add('text-red-700');
                    }
                }
            });
        })();
    </script>
</Layout>
