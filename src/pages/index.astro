                    <span class="text-[0.875rem] text-stone-600">/mo</span>
                  </div>
                  <div class="mt-3 font-mono text-[0.6875rem] tracking-wide text-stone-600 uppercase">
                    {p.platformFeePercentage === 0 ? (
                      <span class="font-bold text-stone-600">
