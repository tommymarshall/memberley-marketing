        </dl>

        <!-- secondary feature grid -->
        <div class="mt-20 grid grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-4">
          {
            secondaryFeatures.map((f) => (
              <div>
                <div class="mb-3 size-8 rounded-sm border border-stone-300 bg-stone-100" />
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[0.9375rem] font-semibold text-stone-900">
                    {f.title}
                  </span>
                  {f.badge && (
                    <span class="rounded-sm border border-amber-700/30 bg-amber-700/10 px-1.5 py-0.5 font-mono text-[0.625rem] font-medium tracking-wide text-amber-800 uppercase">
                      {f.badge}
                    </span>
                  )}
                </div>
                <div class="mt-1.5 text-[0.8125rem] leading-relaxed text-stone-600">
                  {f.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Purpose-built vs plugin stacks -->
    <section id="platform" class="border-b border-stone-300 bg-stone-100">
      <div class="mx-auto max-w-[80rem] px-6 py-24 lg:px-8">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <div
              class="font-mono text-[0.6875rem] font-medium tracking-wide text-amber-800 uppercase"
            >
              Platform
            </div>
            <h2
              class={`mt-5 max-w-[20ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
            >
              Not a pile of WordPress plugins.
            </h2>
            <p
              class="mt-6 max-w-[52ch] text-[1rem] leading-relaxed text-pretty text-stone-600"
            >
              Some competitors stitch memberships, calendars, and payments
              together from loosely connected plugins and themes. Memberley is a
              single application written for the job — memberships, bookings,
              dues, and the front desk share one codebase and one source of
              truth.
            </p>
            <p
              class="mt-4 max-w-[52ch] text-[1rem] leading-relaxed text-pretty text-stone-600"
            >
              We tuned it first for pools and tight-knit neighborhood
              communities, then invested in depth so it can stretch with you
              into HOAs, larger clubs, and more complex operations without
              ripping out the stack underneath.
            </p>
          </div>
          <div class="flex flex-col justify-center lg:col-span-7">
