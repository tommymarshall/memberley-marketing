      "The long-time incumbent for neighborhood pools — proven since 2010 with deep pool features and responsive support.",
    cons: [
      "$2,000–$3,500/yr before your first member pays — plus $500–$1,000 more if you want hands-on setup.",
      "Payments run through their ECRYPT gateway — you can't bring your own Stripe account.",
      "Reporting that some admins describe as clunky.",
    ],
    win: "Memberley starts at $0/yr + 3% per payment (or $500/yr with zero payment fees), with no setup fee, payouts to your own Stripe in 1–2 business days, a portal and emails branded as your club, and free migration.",
  },
  {
    name: "PoolDues",
    href: "/alternatives/pooldues",
    strong:
      "Purpose-built for swim & tennis clubs with one simple flat annual price.",
    cons: [
      "$1,999/yr for the whole bundle, used or not.",
      "Payments run through PayPal rather than your own Stripe account.",
      "They host your website on their servers, so you never fully own it.",
    ],
    win: "Memberley starts at $0/yr + 3% per payment (or $500/yr with zero payment fees), you pay for only the modules you need, payouts land in your own Stripe account, and the portal embeds into the website you already have.",
  },
  {
    name: "CourtReserve",
    href: "/alternatives/courtreserve",
    strong: "Strong court scheduling built for tennis & pickleball clubs.",
    cons: [
      "Designed around courts — not seasonal pool memberships, guest passes, and front-gate check-in.",
      "SMS and email broadcasts are metered — 500 texts and 5,000 marketing emails a month, then you pay per bundle.",
      "The branded club app is gated to the top tier, with a $499 setup fee and a one-year contract.",
    ],
    win: "Memberley is pool-first: seasonal tiers, guest-pass auto-charge at the gate, and a check-in line that actually moves, with flat-priced modules instead of metered SMS and email.",
  },
];

const signupPerks = [
  "14-day free trial, no card",
  "Setup in under 10 minutes",
  "Import members via CSV",
  "Cancel anytime",
];
---

<Layout>
  <div
    class="min-h-dvh paper-light font-sans text-stone-900 antialiased isolate"
  >
    <SiteHeader />

    <!-- Hero -->
    <section
      class="relative isolate overflow-hidden border-b border-stone-950/10"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 grid-veil"
      >
      </div>
      <div
        class="mx-auto grid max-w-[80rem] grid-cols-1 gap-16 px-6 pt-10 pb-24 lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-20"
      >
        <div class="lg:col-span-5">
          <a
            href="#features"
            class="mb-8 inline-flex items-center gap-2 rounded-full bg-stone-100 py-1 pr-3 pl-1 ring-1 ring-stone-950/10 transition hover:ring-stone-950/20"
          >
            <span
              class="flex items-center gap-1.5 rounded-full bg-brand-700 px-2 py-0.5 text-[0.6875rem] font-medium tracking-wide text-white uppercase"
            >
              <span class="size-1.5 rounded-full bg-white"></span>
              New
            </span>
            <span class="text-[0.75rem] text-stone-700">
              Custom member fields, enrollment questions &amp; SMS texts are
              live →
            </span>
          </a>

          <h1
            class={`max-w-[20ch] text-[clamp(2.75rem,4vw,4.5rem)] leading-[1] text-balance ${display} text-stone-900`}
          >
            Run your community like it runs itself.
          </h1>

          <p
            class="mt-8 max-w-[52ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            Memberships, reservations, payments, classes, comms, and front-desk
            check-ins, in one calm workspace built for the person actually
            running the club.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class={`group inline-flex items-center gap-2 rounded-sm py-2.5 pr-5 pl-5 text-[0.875rem] font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 ${primaryBtn}`}
            >
              Start free trial
              <span class="transition group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href={DEMO_URL}
              class={`inline-flex items-center gap-2 rounded-sm py-2.5 pr-5 pl-5 text-[0.875rem] font-medium transition ${secondaryBtn}`}
            >
              Explore the live demo
            </a>
          </div>

          <div
            class="mt-12 flex items-center gap-6 text-[0.75rem] text-stone-600"
          >
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-brand-600"></span>
              Built for swim clubs, HOAs &amp; private clubs
            </div>
          </div>
        </div>

        <!-- Right — product screenshot -->
        <div
          class="relative isolate flex items-center lg:col-span-7 lg:-mr-12 xl:-mr-24"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -inset-8 -z-10 halo-brand"
          >
          </div>
          <picture class="block w-full">
            <source srcset="/app-members.webp" type="image/webp" />
            <img
              src="/app-members.png"
              alt="Memberley Members dashboard showing active members, tiers, and invite link"
              width="1400"
              height="897"
              class="w-full rounded-lg bg-white shadow-paper ring-1 ring-stone-950/5"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </section>

    <!-- Purpose-built vs plugin stacks -->
    <section id="platform" class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[80rem] px-6 py-20 lg:px-8">
        <div
          data-reveal
          class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16"
        >
          <div class="lg:col-span-5">
            <div
              class="font-mono text-[0.6875rem] font-medium tracking-wide text-brand-400 uppercase"
            >
              Platform
            </div>
            <h2
              class={`mt-5 max-w-[20ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
            >
              Not a pile of WordPress plugins.
            </h2>
            <p
              class="mt-6 max-w-[52ch] text-[1rem] leading-relaxed text-pretty text-stone-300"
            >
              Some competitors stitch memberships, calendars, and payments
              together from loosely connected plugins and themes, which makes
              every change to your website a small project. Memberley is a
              single application written for the job: memberships, bookings,
              dues, branding, and embedding are designed together, so each piece
              works with the rest and stays easy to customize.
            </p>
            <p
              class="mt-4 max-w-[52ch] text-[1rem] leading-relaxed text-pretty text-stone-300"
            >
              We tuned it first for pools, courts, and tight-knit neighborhood
              communities, then invested in depth so it can stretch with you
              into HOAs, larger clubs, and more complex operations without
              ripping out the stack underneath.
            </p>
          </div>
          <div class="flex flex-col justify-center lg:col-span-7">
            <ul
              role="list"
              class="divide-y divide-white/10 rounded-lg bg-stone-950 ring-1 ring-white/10"
            >
              <li class="flex gap-4 p-6 md:p-8">
                <span
                  class="mt-0.5 font-mono text-[0.75rem] font-medium tracking-wide text-brand-400"
                  aria-hidden="true"
                >
                  →
                </span>
                <div>
                  <div class="text-[0.9375rem] font-semibold text-stone-50">
                    Designed as one product
                  </div>
                  <p
                    class="mt-2 max-w-[48ch] text-[0.875rem] leading-relaxed text-stone-400"
                  >
                    Flows fit together intentionally — no fragile glue between
                    unrelated extensions.
                  </p>
                </div>
              </li>
              <li class="flex gap-4 p-6 md:p-8">
                <span
                  class="mt-0.5 font-mono text-[0.75rem] font-medium tracking-wide text-brand-400"
                  aria-hidden="true"
                >
                  →
                </span>
                <div>
                  <div class="text-[0.9375rem] font-semibold text-stone-50">
                    Fits today, grows tomorrow
                  </div>
                  <p
                    class="mt-2 max-w-[48ch] text-[0.875rem] leading-relaxed text-stone-400"
                  >
                    Ready for modest communities now, with room to expand
                    billing, facilities, and staff workflows as you approach HOA
                    or country-club scale.
                  </p>
                </div>
              </li>
              <li class="flex gap-4 p-6 md:p-8">
                <span
                  class="mt-0.5 font-mono text-[0.75rem] font-medium tracking-wide text-brand-400"
                  aria-hidden="true"
                >
                  →
                </span>
                <div>
                  <div class="text-[0.9375rem] font-semibold text-stone-50">
                    Ownership of your stack
                  </div>
                  <p
                    class="mt-2 max-w-[48ch] text-[0.875rem] leading-relaxed text-stone-400"
                  >
                    Fewer surprises from plugin conflicts, discontinued add-ons,
                    or someone else’s generic site builder.
                  </p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[80rem] px-6 py-24 lg:px-8">
        <div data-reveal class="mb-16 max-w-[44ch]">
          <div class={eyebrow}>§ Features</div>
          <h2
            class={`mt-5 max-w-[24ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Everything your club actually needs.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            One workspace, zero spreadsheets: your board, your staff, and your
            members all see the same truth. The essentials come with every plan;
            features marked as add-ons are <a
              href="#pricing"
              class="font-medium text-stone-900 underline decoration-stone-400 underline-offset-2 transition hover:decoration-stone-900"
              >flat-priced modules</a
            > you switch on only if your club needs them.
          </p>
        </div>

        <dl
          class="grid grid-cols-1 divide-y divide-stone-950/10 border-y border-stone-950/10 md:grid-cols-2 md:divide-x md:divide-y-0"
        >
          {
            primaryFeatures.map((f, i) => (
              <div
                data-reveal
                style={`--reveal-delay:${(i % 2) * 70}ms`}
                class={`relative p-8 md:p-10 ${i >= 2 ? "md:border-t md:border-stone-950/10" : ""}`}
              >
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-7 right-7 font-serif text-[3.5rem] leading-none font-semibold text-stone-950/6 tabular-nums select-none"
                >
                  {f.n}
                </span>
                <div class="flex size-10 items-center justify-center rounded-lg bg-brand-700/10 text-brand-700 ring-1 ring-brand-700/15">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5"
                    aria-hidden="true"
                    set:html={f.icon}
                  />
                </div>
                <dt
                  class={`mt-5 flex flex-wrap items-center gap-2.5 text-[1.375rem] ${display} text-stone-900`}
                >
                  {f.title}
                  {f.addon && (
                    <a
                      href="#pricing"
                      class="rounded-sm border border-stone-950/15 bg-stone-100 px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium tracking-wide text-stone-600 uppercase transition hover:border-stone-950/30 hover:text-stone-900"
                    >
                      {f.addon}
                    </a>
                  )}
                </dt>
                <dd class="mt-3 max-w-[46ch] text-[0.9375rem] leading-relaxed text-stone-600">
                  {f.desc}
                </dd>
              </div>
            ))
          }
        </dl>

        <div data-reveal class="mt-16 flex items-center gap-5">
          <h3 class={`shrink-0 text-[1.375rem] ${display} text-stone-900`}>
            and many more
          </h3>
          <div class="h-px flex-1 bg-stone-950/10"></div>
        </div>
        <!-- secondary features, grouped by the job they do -->
        <div
          data-reveal
          class="mt-10 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            featureGroups.map((g) => (
              <div>
                <div class="font-mono text-[0.6875rem] font-medium tracking-wide text-stone-500 uppercase">
                  {g.title}
                </div>
                <ul role="list" class="mt-4 space-y-3">
                  {g.items.map((f) => (
                    <li class="flex items-center gap-2.5 text-[0.9375rem] text-stone-700">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-5 shrink-0 text-brand-700"
                        aria-hidden="true"
                        set:html={f.icon}
                      />
                      <span>{f.title}</span>
                      {f.badge && (
                        <span class="rounded-sm border border-brand-700/30 bg-brand-700/10 px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase">
                          {f.badge}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section id="compare" class="border-b border-stone-950/10 bg-stone-50">
      <div class="mx-auto max-w-[80rem] px-6 py-24 lg:px-8">
        <div data-reveal class="mb-12 max-w-[52ch]">
          <div class={eyebrow}>§ Compare</div>
          <h2
            class={`mt-5 max-w-[24ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            How Memberley stacks up.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            Built for neighborhood pools, courts, and community swim clubs, so
            the comparison that matters is against the tools you&rsquo;ve
            already tried.
          </p>
        </div>

        <!-- Comparison table -->
        <div
          data-reveal
          class="overflow-x-auto rounded-lg bg-white shadow-paper ring-1 ring-stone-950/5"
        >
          <table class="w-full min-w-[46rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-stone-950/10 bg-stone-100">
                <th class="w-[32%] p-4"></th>
                {
                  compareColumns.map((c, i) => (
                    <th
                      class={`p-4 text-center ${i === 0 ? "bg-brand-700/10" : ""}`}
                    >
                      <img
                        src={c.logo}
                        alt={c.name}
                        class={`mx-auto block h-7 w-auto object-contain ${c.isOwn ? "" : "opacity-60 grayscale"}`}
                        loading="lazy"
                        decoding="async"
                      />
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                compareRows.map((row) => (
                  <tr class="border-b border-stone-950/5 last:border-0">
                    <th class="p-4 align-middle text-[0.8125rem] font-medium text-stone-700">
                      {row.label}
                    </th>
                    {row.cells.map((cell, i) => (
                      <td
                        class={`p-4 text-center align-middle ${i === 0 ? "bg-brand-700/5" : ""}`}
                      >
                        {typeof cell === "string" ? (
                          <span class="text-[0.8125rem] text-stone-700">
                            {cell}
                          </span>
                        ) : cell === true ? (
                          <svg
                            class="mx-auto size-4 text-brand-700"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-label="Yes"
                          >
                            <path
                              d="M3 8.3l3 3 7-7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : cell === false ? (
                          <span
                            class="text-[0.875rem] text-stone-400"
                            aria-label="No"
                          >
                            ✕
                          </span>
                        ) : (
                          <span class="text-stone-300" aria-label="Not offered">
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p
          class="mt-3 font-mono text-[0.75rem] tracking-wide text-stone-500 md:hidden"
        >
          Swipe sideways to compare →
        </p>
        <p
          class="mt-4 max-w-[75ch] font-mono text-[0.75rem] tracking-wide text-stone-500"
        >
          * Competitor pricing &amp; features as published on their own sites
          (2026).
        </p>

        <!-- Why clubs switch -->
        <div
          class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-lg bg-stone-950/10 ring-1 ring-stone-950/10 md:grid-cols-3"
        >
          {
            switchCards.map((c) => (
              <div class="flex flex-col bg-stone-50 p-8">
                <div class="font-mono text-[0.6875rem] tracking-wide text-stone-500 uppercase">
                  Switching from
                </div>
                <h3 class={`mt-2 text-[1.375rem] ${display} text-stone-900`}>
                  {c.name}
                </h3>
                <p class="mt-3 text-[0.8125rem] leading-relaxed text-stone-500">
                  {c.strong}
                </p>
                <ul class="mt-5 space-y-2.5 border-t border-stone-950/10 pt-5">
                  {c.cons.map((s) => (
                    <li class="flex gap-2.5 text-[0.8125rem] leading-relaxed text-stone-600">
                      <span class="mt-0.5 shrink-0 text-stone-400">−</span>
                      {s}
                    </li>
                  ))}
                </ul>
                <p class="mt-5 border-t border-stone-950/10 pt-5 text-[0.8125rem] leading-relaxed text-stone-700">
                  <span class="font-semibold text-brand-800">Memberley:</span>{" "}
                  {c.win}
                </p>
                <a
                  href={c.href}
                  class="mt-5 inline-flex items-center gap-1.5 text-[0.8125rem] font-medium text-stone-900 transition hover:text-brand-800"
                >
                  Read the full {c.name} comparison
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            ))
          }
        </div>

        <!-- SwimTopia complement -->
        <div
          class="mt-10 flex flex-col gap-3 rounded-lg bg-brand-700/5 p-6 ring-1 ring-brand-700/25 md:flex-row md:items-center md:gap-6"
        >
          <div
            class="font-mono text-[0.6875rem] tracking-wide text-brand-800 uppercase md:w-44 md:shrink-0"
          >
            On a swim team?
          </div>
          <p class="text-[0.875rem] leading-relaxed text-stone-700">
            Keep your team on <strong>SwimTopia</strong> — now NVSL&rsquo;s official
            platform for meets and registration. Memberley runs the
            <em>pool</em>: memberships, dues, guest passes, and the front gate:
            the side SwimTopia doesn&rsquo;t cover. The two work side by side.
          </p>
        </div>
      </div>
    </section>

    <!-- Inverse section: use cases -->
    <section class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[80rem] px-6 py-24 lg:px-8">
        <div data-reveal class="mb-14 max-w-[48ch]">
          <div
            class="font-mono text-[0.6875rem] font-medium tracking-wide text-brand-400 uppercase"
          >
            § Built for
          </div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
          >
            Whatever your community calls itself.
          </h2>
        </div>

        <div
          class="grid grid-cols-1 divide-y divide-white/10 border-y border-white/10 md:grid-cols-3 md:divide-x md:divide-y-0"
        >
          {
            useCases.map((c) => (
              <div class="flex flex-col gap-6 p-8">
                <div class="font-mono text-[0.6875rem] font-medium tracking-wide text-brand-400 uppercase">
                  {c.tag}
                </div>
                <ul role="list" class="space-y-3">
                  {c.bullets.map((b) => (
                    <li class="flex items-start gap-3 text-[0.9375rem] text-stone-300">
                      <span class="mt-0.5 font-mono text-brand-400">→</span>
                      {b}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="border-b border-stone-950/10 bg-stone-50">
      <div class="mx-auto max-w-[80rem] px-6 py-28 lg:px-8">
        <div data-reveal class="mb-14 max-w-[56ch]">
          <div class={eyebrow}>§ Pricing</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Unlimited members. Pay for what you need.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            Every plan starts with unlimited members and the essentials to run
            your club. Add modules only when you need them, and try everything
            free for 14 days, no card required.
          </p>
        </div>

        <!-- Community plans + what every plan includes -->
        <div
          data-reveal
          class="overflow-hidden rounded-lg bg-white shadow-paper ring-1 ring-stone-950/5"
        >
          <div
            class="grid grid-cols-1 divide-y divide-stone-950/10 md:grid-cols-2 md:divide-x md:divide-y-0"
          >
            {
              plans.map((p) => (
                <div
                  class={`relative flex flex-col justify-between gap-8 p-8 ${p.featured ? "bg-brand-700/6" : ""}`}
                >
                  {p.featured && (
                    <>
                      <span
                        aria-hidden="true"
                        class="absolute inset-x-0 top-0 h-1 bg-brand-600"
                      />
                      <span class="absolute top-6 right-6 rounded-sm bg-brand-700 px-2 py-0.5 font-mono text-[0.6875rem] font-medium tracking-wide text-white uppercase">
                        Recommended
                      </span>
                    </>
                  )}
                  <div>
                    <div class="font-mono text-[0.6875rem] tracking-wide text-stone-600 uppercase">
                      {p.name}
                    </div>
                    <p class="mt-3 max-w-[34ch] text-[0.8125rem] leading-relaxed text-stone-600">
                      {p.tagline}
                    </p>
                    <div class="mt-5 flex items-baseline gap-1">
                      <span
                        class={`text-[3rem] leading-none ${display} text-stone-900 tabular-nums`}
                      >
                        {p.price}
                      </span>
                      <span class="text-[0.875rem] text-stone-600">
                        {perInterval(p.interval)}
                      </span>
                    </div>
                    <div class="mt-3 font-mono text-[0.6875rem] tracking-wide uppercase">
                      {p.platformFeePercentage === 0 ? (
                        <span class="font-bold text-brand-800">
                          {feeLabel(p.platformFeePercentage)}
                        </span>
                      ) : (
                        <span class="text-stone-600">
                          {feeLabel(p.platformFeePercentage)}
                        </span>
                      )}
                    </div>
                  </div>
                  <a
                    href={`${SIGNUP_URL}?plan=${encodeURIComponent(p.slug)}`}
                    class={`block rounded-sm py-2.5 text-center text-[0.875rem] font-medium transition ${p.featured ? "bg-stone-900 text-stone-50 shadow-btn hover:bg-stone-800" : "border border-stone-950/15 text-stone-900 hover:border-stone-950/30 hover:bg-stone-100"}`}
                  >
                    {p.cta}
                  </a>
                </div>
