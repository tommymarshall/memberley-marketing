            Open your doors in under an hour.
          </h2>
          <p
            class="mt-6 max-w-[44ch] text-[1rem] leading-relaxed text-stone-400"
          >
            Create your organization, set up your membership tiers, and share
            the signup link with your members. That&rsquo;s the whole thing.
          </p>

          <ul
            role="list"
            class="mt-10 space-y-3 border-t border-stone-800 pt-8"
          >
            {
              signupPerks.map((i) => (
                <li class="flex items-center gap-3 text-[0.875rem] text-stone-300">
                  <span class="font-mono text-amber-400">→</span>
                  {i}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="col-span-7">
          <div class="rounded-lg border border-stone-800 bg-stone-950 p-8">
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center gap-2">
                <img
                  src="/memberley-amper-dark.svg"
                  alt=""
