          >
            Simple Pricing... and a free trial
          </h2>
        </div>

        <div
          class="grid grid-cols-1 divide-y divide-stone-300 border border-stone-300 md:grid-cols-3 md:divide-x md:divide-y-0"
        >
          {
            plans.map((p) => (
              <div class="relative flex flex-col justify-between p-8">
                {p.featured && (
                  <span class="absolute top-6 right-6 rounded-sm bg-amber-700 px-2 py-0.5 font-mono text-[0.625rem] font-medium tracking-wide text-white uppercase">
                    Recommended
                  </span>
                )}
                <div>
                  <div class="font-mono text-[0.6875rem] tracking-wide text-stone-600 uppercase">
