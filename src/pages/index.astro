---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Testimonials from "../components/Testimonials.astro";
import {
  APP_URL,
  CONTACT_EMAIL,
  DEMO_LOGIN_URL,
  SIGNUP_URL,
  alternatives,
} from "../config/site";

declare const process: {
  env: {
    NODE_TLS_REJECT_UNAUTHORIZED?: string;
  };
};

type ApiPlan = {
  id: number;
  slug: string;
  name: string;
  description: string | null;
  price_cents: number;
  price_formatted: string;
  billing_interval: "month" | "year";
  trial_days: number;
  platform_fee_percentage: number;
};

type MarketingPlan = {
  slug: string;
  name: string;
  price: string;
  interval: "month" | "year";
  tagline: string;
  featured: boolean;
  platformFeePercentage: number;
};

type AddOnModule = {
  name: string;
  price: string;
  description: string;
  /** Short pill next to the name — "New" for a just-launched module. */
  badge?: string;
};

const marketingMeta: Record<string, { featured: boolean; tagline: string }> = {
  starter: {
    featured: false,
    tagline:
      "Every membership essential, nothing up front — you don't pay a dollar until your members start paying you.",
  },
  community: {
    featured: true,
    tagline:
      "A flat annual price for established clubs that want to keep every dollar of dues.",
  },
};

const fallbackPlans: MarketingPlan[] = [
  {
    slug: "starter",
    name: "Starter",
    price: "$0",
    interval: "year",
    tagline: marketingMeta.starter.tagline,
    featured: false,
    platformFeePercentage: 3,
  },
  {
    slug: "community",
    name: "Community",
    price: "$500",
    interval: "year",
    tagline: marketingMeta.community.tagline,
    featured: true,
    platformFeePercentage: 0,
  },
];

let plans: MarketingPlan[] = fallbackPlans;

const previousTlsReject = process.env.NODE_TLS_REJECT_UNAUTHORIZED;
const isLocalHerd = APP_URL.includes(".test");
if (isLocalHerd) {
  process.env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
}

try {
  const response = await fetch(`${APP_URL}/api/v1/plans`, {
    headers: { Accept: "application/json" },
  });

  if (response.ok) {
    const json = (await response.json()) as { data: ApiPlan[] };
    if (Array.isArray(json.data) && json.data.length > 0) {
      plans = json.data.map((plan): MarketingPlan => {
        const slug = plan.slug === "base" ? "community" : plan.slug;
        const name = plan.name === "Base" ? "Community" : plan.name;
        const meta = marketingMeta[slug] ?? {
          featured: false,
          tagline: plan.description ?? "",
        };

        return {
          slug,
          name,
          price: plan.price_formatted,
          interval: plan.billing_interval,
          tagline: meta.tagline,
          featured: meta.featured,
          platformFeePercentage: Number(plan.platform_fee_percentage ?? 0),
        };
      });
    }
  }
} catch (error) {
  console.warn("Plans API fetch failed; using fallback pricing.", error);
} finally {
  if (isLocalHerd) {
    if (previousTlsReject === undefined) {
      delete process.env.NODE_TLS_REJECT_UNAUTHORIZED;
    } else {
      process.env.NODE_TLS_REJECT_UNAUTHORIZED = previousTlsReject;
    }
  }
}

const modules: AddOnModule[] = [
  {
    name: "Facilities & reservations",
    price: "$250/yr",
    description: "Courts, lanes, rooms, approvals, and conflict checks.",
  },
  {
    name: "Front desk & check-in",
    price: "$250/yr",
    description: "Gate check-in, QR scanning, and guest-pass tracking.",
  },
  {
    name: "Point of sale",
    price: "$250/yr",
    description: "Snack bar and pro shop sales with daily reporting.",
  },
  {
    name: "Classes & events",
    price: "$200/yr",
    description: "Registration, rosters, sessions, camps, and lessons.",
  },
  {
    name: "Communications",
    price: "$150/yr",
    description: "Email campaigns and SMS broadcasts to member segments.",
  },
  {
    name: "Assessments & capital fees",
    price: "$150/yr",
    badge: "New",
    description:
      "Capital contributions for a member's first years, initiation fees, and one-time special assessments.",
  },
  {
    name: "Branded site & embed",
    price: "$100/yr",
    description: "A member portal that fits the website you already have.",
  },
];

/**
 * What "white glove" actually covers. Kept concrete deliberately: this is a
 * promise a person has to keep, so each line names work someone does rather
 * than a feeling about onboarding.
 */
const setupSteps = [
  {
    title: "Your roster, moved",
    body: "Members, households, and contact details brought over from your current system or a spreadsheet — with families kept intact, not flattened into a list of names.",
  },
  {
    title: "Season, tiers, and dues",
    body: "Your membership tiers, dues amounts, family and per-person pricing, prorating, and installment plans, configured to match what your club already charges.",
  },
  {
    title: "Documents and custom fields",
    body: "Waivers, bylaws, and every question you ask at registration — loaded and ready to collect before your signup link goes out.",
  },
  {
    title: "Facilities and programs",
    body: "Courts, pool hours, reservation rules, guest passes, and your classes, camps, and swim team — set up for the clubs that run them.",
  },
];

const baseFeatures = [
  "Unlimited members",
  "Online dues, ACH, and card payments",
  "Member portal and online signup",
  "Household and per-person family pricing",
  "Custom member fields",
  "Waitlists with auto-promotion",
  "Reports, exports, and activity history",
  "QuickBooks and Mailchimp integrations",
  "White-glove season setup and member migration",
];

const outcomes = [
  {
    number: "01",
    title: "Memberships stay current.",
    body: "Families join, renew, update their household, and pay without a board member moving data between forms and spreadsheets.",
    detail: "Tiers · household pricing · waitlists",
  },
  {
    number: "02",
    title: "Money reconciles itself.",
    body: "Dues, assessments, payment plans, late fees, discounts, and receipts flow through your own Stripe account with a clean audit trail.",
    detail: "Card + ACH · payouts · reporting",
  },
  {
    number: "03",
    title: "The front desk keeps moving.",
    body: "Staff find a member, scan a QR code, deduct guest passes, and handle the next family without slowing the line.",
    detail: "Check-in · guests · point of sale",
  },
];

const moreCapabilities = [
  "Facility reservations",
  "Classes, camps & lessons",
  "Email and SMS campaigns",
  "Waivers & documents",
  "Branded member portal",
  "Season-by-season reporting",
];

const primaryButton =
  "inline-flex items-center justify-center gap-2 rounded-full bg-stone-950 px-5 py-3 text-[0.875rem] font-semibold text-white shadow-btn transition hover:-translate-y-px hover:bg-stone-800 motion-reduce:transform-none";
const secondaryButton =
  "inline-flex items-center justify-center gap-2 rounded-full border border-stone-950/14 bg-white/72 px-5 py-3 text-[0.875rem] font-semibold text-stone-800 shadow-[0_1px_0_rgb(255_255_255/.8)_inset] transition hover:-translate-y-px hover:border-stone-950/24 hover:bg-white motion-reduce:transform-none";
const eyebrow =
  "font-mono text-[0.625rem] font-semibold tracking-[0.14em] text-brand-800 uppercase";

function formatFee(value: number): string {
  return value > 0 ? `${value}% per payment` : "No Memberley payment fee";
}
---

<Layout
  title="Memberley — Membership Software for Pool & Swim-Tennis Clubs"
  description="Run memberships, dues, reservations, classes, communications, and front-desk check-in in one calm workspace. Explore the live demo or start a 45-day free trial."
>
  <div class="min-h-dvh overflow-clip paper-light font-sans text-stone-900">
    <SiteHeader />

    <main>
      <section class="site-header-offset relative hero-wash">
        <div
          class="pointer-events-none absolute inset-0 hairline-grid opacity-55"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative mx-auto grid max-w-[74rem] items-center gap-12 px-5 pt-16 pb-12 sm:px-7 sm:pt-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10 lg:px-8 lg:pt-24 lg:pb-16"
        >
          <div class="relative z-10 max-w-[40rem]">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-brand-900/10 bg-white/58 px-3 py-1.5 shadow-[0_1px_0_rgb(255_255_255/.8)_inset] backdrop-blur-sm"
            >
              <span class="size-1.5 rounded-full bg-brand-600"></span>
              <span class={eyebrow}>Built for pool & swim-tennis clubs</span>
            </div>
            <h1
              class="mt-6 max-w-[13ch] font-serif text-[clamp(3.05rem,5.5vw,4.9rem)] leading-[0.93] font-semibold tracking-[-0.055em] text-balance text-stone-950"
            >
              Run your community like it runs itself.
            </h1>
            <p
              class="mt-7 max-w-[47ch] text-[1.0625rem] leading-[1.65] text-pretty text-stone-600 sm:text-[1.125rem]"
            >
              Memberships, payments, check-in, reservations, classes, and
              communications in one calm workspace—so your board can spend less
              time administering the club and more time enjoying it.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={DEMO_LOGIN_URL}
                data-marketing-event="live_demo_clicked"
                data-marketing-location="hero"
                class={primaryButton}
              >
                Explore the live demo <span aria-hidden="true">→</span>
              </a>
              <a
                href={SIGNUP_URL}
                data-marketing-event="trial_started"
                data-marketing-location="hero"
                class={secondaryButton}
              >
                Start a 45-day free trial
              </a>
            </div>
            <p
              class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[0.6875rem] tracking-[0.04em] text-stone-500"
            >
              <span>Pay only when members pay you</span>
              <span aria-hidden="true">·</span>
              <span>Add-ons free your first year</span>
              <span aria-hidden="true">·</span>
              <span>Unlimited members</span>
              <span aria-hidden="true">·</span>
              <span>Free setup and migration</span>
            </p>
          </div>

          <div
            class="relative -mx-5 min-w-0 sm:-mx-7 lg:mr-[-8rem] lg:ml-[-3rem] xl:mr-[-10rem]"
          >
            <img
              src="/hero-macbook.webp"
              alt="A dark aluminum MacBook displaying Memberley's member roster"
              width="1536"
              height="1024"
              class="hero-product-photo block w-full"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <section id="features" class="border-t border-stone-950/8 bg-[#faf9f7]">
        <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-28">
          <div class="max-w-[40rem]" data-reveal>
            <div class={eyebrow}>One workspace</div>
            <h2
              class="mt-5 max-w-[17ch] font-serif text-[clamp(2.5rem,5vw,4.35rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance text-stone-950"
            >
              Three jobs your club can stop stitching together.
            </h2>
          </div>

          <div
            class="mt-14 grid border-y border-stone-950/9 lg:grid-cols-3 lg:divide-x lg:divide-stone-950/9"
          >
            {
              outcomes.map((outcome, index) => (
                <article
                  data-reveal
                  style={`--reveal-delay:${index * 80}ms`}
                  class="border-b border-stone-950/9 py-8 last:border-b-0 lg:border-b-0 lg:px-8 lg:first:pl-0 lg:last:pr-0"
                >
                  <div class="font-mono text-[0.625rem] font-semibold tracking-[0.14em] text-brand-700">
                    {outcome.number}
                  </div>
                  <h3 class="mt-8 max-w-[18ch] font-serif text-[1.65rem] leading-[1.08] font-semibold tracking-[-0.035em] text-stone-950">
                    {outcome.title}
                  </h3>
                  <p class="mt-4 max-w-[39ch] text-[0.9375rem] leading-[1.65] text-stone-600">
                    {outcome.body}
                  </p>
                  <p class="mt-8 font-mono text-[0.625rem] tracking-[0.1em] text-stone-400 uppercase">
                    {outcome.detail}
                  </p>
                </article>
              ))
            }
          </div>

          <aside
            data-reveal
            class="mt-6 grid gap-6 rounded-[1.15rem] border border-brand-800/12 bg-brand-100/42 p-6 sm:grid-cols-[auto_1fr] sm:items-start sm:p-8"
          >
            <span
              class="inline-flex w-fit rounded-full border border-brand-800/16 bg-white/72 px-2.5 py-1 font-mono text-[0.5625rem] font-semibold tracking-[0.12em] text-brand-800 uppercase"
            >
              New
            </span>
            <div class="grid gap-4 lg:grid-cols-[0.72fr_1.28fr] lg:gap-10">
              <h3
                class="max-w-[18ch] font-serif text-[1.6rem] leading-[1.08] font-semibold tracking-[-0.035em] text-stone-950"
              >
                Household pricing that follows your club’s rules.
              </h3>
              <p
                class="max-w-[70ch] text-[0.875rem] leading-[1.7] text-stone-600"
              >
                Make a tier individual-only, include a fixed family size, or add
                a per-person rate after the people covered by the base price.
                Minimum ages, household caps, capacity counting, renewals,
                payment plans, and mid-season proration all follow the same
                setup.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section class="border-t border-stone-950/8 bg-white/62">
        <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-28">
          <div
            class="grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16"
          >
            <div data-reveal>
              <div class={eyebrow}>Money without the mystery</div>
              <h2
                class="mt-5 max-w-[13ch] font-serif text-[clamp(2.3rem,4.5vw,3.9rem)] leading-[1] font-semibold tracking-[-0.045em] text-stone-950"
              >
                Know what came in. Know what happens next.
              </h2>
              <p
                class="mt-6 max-w-[44ch] text-[1rem] leading-[1.7] text-stone-600"
              >
                Every payment, payout, fee, discount, and balance is visible in
                one place. Funds settle into your club’s own Stripe
                account—never a black box controlled by your software vendor.
              </p>
              <ul class="mt-7 grid gap-3 text-[0.875rem] text-stone-700">
                {
                  [
                    "Card and ACH bank payments",
                    "Autopay, installments, and late fees",
                    "Capital fees, initiation fees, and special assessments",
                    "Receipts, exports, and QuickBooks sync",
                  ].map((item) => (
                    <li class="flex items-center gap-3">
                      <span class="grid size-5 place-items-center rounded-full bg-brand-100 text-[0.6875rem] font-bold text-brand-800">
                        ✓
                      </span>
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="browser-frame" data-reveal style="--reveal-delay:90ms">
              <div class="browser-chrome"><span></span></div>
              <img
                src="/product/payments.webp"
                alt="Memberley payments dashboard with revenue trends and recent transactions"
                width="2880"
                height="1800"
                loading="lazy"
                decoding="async"
                class="block aspect-[16/10] w-full object-cover object-left-top"
              />
            </div>
          </div>

          <div
            class="mt-24 grid items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16"
          >
            <div class="browser-frame lg:order-1" data-reveal>
              <div class="browser-chrome"><span></span></div>
              <img
                src="/product/check-in.webp"
                alt="Memberley front desk showing live member check-ins"
                width="2880"
                height="1800"
                loading="lazy"
                decoding="async"
                class="block aspect-[16/10] w-full object-cover object-left-top"
              />
            </div>
            <div class="lg:order-2" data-reveal style="--reveal-delay:90ms">
              <div class={eyebrow}>Opening day, minus the scramble</div>
              <h2
                class="mt-5 max-w-[13ch] font-serif text-[clamp(2.3rem,4.5vw,3.9rem)] leading-[1] font-semibold tracking-[-0.045em] text-stone-950"
              >
                A front desk the summer staff can learn in minutes.
              </h2>
              <p
                class="mt-6 max-w-[44ch] text-[1rem] leading-[1.7] text-stone-600"
              >
                Search by name or scan a member QR code. Guest passes deduct
                automatically, every visit gets logged, and the next family is
                already moving through the gate.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="border-t border-stone-950/8 bg-[#f1ede7]">
        <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-28">
          <div class="grid gap-8 lg:grid-cols-[0.76fr_1.24fr] lg:gap-12">
            <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
              <div class={eyebrow}>The rest of the club, too</div>
              <h2
                class="mt-5 max-w-[14ch] font-serif text-[clamp(2.35rem,4.5vw,3.85rem)] leading-[1] font-semibold tracking-[-0.045em] text-stone-950"
              >
                One login from registration to closing day.
              </h2>
              <p
                class="mt-6 max-w-[40ch] text-[0.9375rem] leading-[1.7] text-stone-600"
              >
                Turn on only the modules your club needs — every one is free for
                your first year. They share the same member records,
                permissions, payments, and activity history.
              </p>
              <div class="mt-7 flex flex-wrap gap-2">
                {
                  moreCapabilities.map((capability) => (
                    <span class="rounded-full border border-stone-950/9 bg-white/70 px-3 py-1.5 text-[0.75rem] font-medium text-stone-600">
                      {capability}
                    </span>
                  ))
                }
              </div>
            </div>

            <div class="grid gap-5">
              <figure
                class="browser-frame"
                data-reveal
                style="--reveal-delay:70ms"
              >
                <div class="browser-chrome"><span></span></div>
                <img
                  src="/product/reservations.webp"
                  alt="Memberley facility reservations overview"
                  width="2880"
                  height="1800"
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[16/10] w-full object-cover object-left-top"
                />
                <figcaption
                  class="border-t border-stone-950/8 bg-white px-5 py-4 text-[0.8125rem] font-medium text-stone-600"
                >
                  Reservations with approvals, blocks, conflict checks, and a
                  week at a glance.
                </figcaption>
              </figure>
              <figure
                class="browser-frame ml-[8%]"
                data-reveal
                style="--reveal-delay:90ms"
              >
                <div class="browser-chrome"><span></span></div>
                <img
                  src="/product/programs.webp"
                  alt="Memberley classes and events catalog"
                  width="2880"
                  height="1800"
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[16/10] w-full object-cover object-left-top"
                />
                <figcaption
                  class="border-t border-stone-950/8 bg-white px-5 py-4 text-[0.8125rem] font-medium text-stone-600"
                >
                  Classes, clinics, camps, and events with registration and
                  rosters built in.
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <section id="demo" class="paper-dark text-white">
        <div
          class="mx-auto grid max-w-[74rem] items-center gap-12 px-5 py-20 sm:px-7 lg:grid-cols-[0.76fr_1.24fr] lg:gap-14 lg:px-8 lg:py-28"
        >
          <div data-reveal>
            <div
              class="font-mono text-[0.625rem] font-semibold tracking-[0.14em] text-brand-300 uppercase"
            >
              No sales call required
            </div>
            <h2
              class="mt-5 max-w-[12ch] font-serif text-[clamp(2.5rem,5vw,4.35rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance"
            >
              Click around before you commit to anything.
            </h2>
            <p
              class="mt-6 max-w-[42ch] text-[1rem] leading-[1.7] text-stone-400"
            >
              The live demo is a complete sample club—not a guided slideshow.
              Open the roster, check someone in, review payments, and see how a
              season actually fits together.
            </p>
            <a
              href={DEMO_LOGIN_URL}
              data-marketing-event="live_demo_clicked"
              data-marketing-location="demo_section"
              class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-[0.875rem] font-semibold text-stone-950 shadow-btn transition hover:-translate-y-px hover:bg-stone-100 motion-reduce:transform-none"
            >
              Enter the live demo <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="relative" data-reveal style="--reveal-delay:90ms">
            <div
              class="absolute -inset-8 rounded-full bg-brand-600/10 blur-3xl"
              aria-hidden="true"
            >
            </div>
            <div
              class="browser-frame relative rotate-[0.35deg] shadow-[0_40px_100px_-34px_rgb(0_0_0/.75)]"
            >
              <div class="browser-chrome"><span></span></div>
              <img
                src="/app-roster.webp"
                alt="Memberley live demo member roster"
                width="2880"
                height="1800"
                loading="lazy"
                decoding="async"
                class="block aspect-[16/10] w-full object-cover object-left-top"
              />
            </div>
          </div>
        </div>
      </section>

      <Testimonials />

      <section id="compare" class="bg-[#faf9f7]">
        <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-28">
          <div
            class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
            data-reveal
          >
            <div>
              <div class={eyebrow}>Considering a switch?</div>
              <h2
                class="mt-5 max-w-[15ch] font-serif text-[clamp(2.35rem,4.5vw,3.85rem)] leading-[1] font-semibold tracking-[-0.045em] text-stone-950"
              >
                Start with an honest comparison.
              </h2>
            </div>
            <p
              class="max-w-[41ch] text-[0.875rem] leading-[1.65] text-stone-500"
            >
              We explain where Memberley is different, where each competitor is
              strong, and what to verify before your board makes a decision.
            </p>
          </div>

          <div class="mt-10 grid gap-3 lg:grid-cols-3">
            {
              alternatives.map((alternative, index) => (
                <a
                  href={alternative.href}
                  data-reveal
                  style={`--reveal-delay:${index * 70}ms`}
                  class="group flex min-h-[15rem] flex-col rounded-[1.1rem] border border-stone-950/9 bg-white p-6 shadow-paper transition duration-300 hover:-translate-y-1 hover:border-brand-700/20 hover:shadow-paper-lg motion-reduce:transform-none"
                >
                  <div class="flex items-start justify-between">
                    <span class="grid size-11 place-items-center rounded-[0.8rem] bg-brand-100 font-mono text-[0.6875rem] font-semibold text-brand-800">
                      {alternative.monogram}
                    </span>
                    <span class="text-stone-300 transition group-hover:translate-x-0.5 group-hover:text-brand-700 motion-reduce:transform-none">
                      →
                    </span>
                  </div>
                  <div class="mt-10">
                    <h3 class="min-h-[3.5rem] font-serif text-[1.45rem] leading-[1.2] font-semibold tracking-[-0.03em] text-stone-950">
                      Memberley vs. {alternative.name}
                    </h3>
                    <p class="mt-3 text-[0.8125rem] leading-[1.6] text-stone-500">
                      {alternative.description}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section id="setup" class="border-t border-stone-950/8 bg-[#f1ede7]">
        <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-28">
          <div class="grid gap-8 lg:grid-cols-[0.76fr_1.24fr] lg:gap-12">
            <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
              <div class={eyebrow}>White glove, free with every club</div>
              <h2
                class="mt-5 max-w-[14ch] font-serif text-[clamp(2.35rem,4.5vw,3.85rem)] leading-[1] font-semibold tracking-[-0.045em] text-stone-950"
              >
                We set up your first season with you.
              </h2>
              <p
                class="mt-6 max-w-[40ch] text-[0.9375rem] leading-[1.7] text-stone-600"
              >
                Changing systems shouldn't cost you a season. Send us your
                roster and what you charged last year, and we'll stand the whole
                thing up — then walk your board through it before registration
                opens.
              </p>
              <p
                class="mt-5 max-w-[40ch] text-[0.9375rem] leading-[1.7] text-stone-600"
              >
                No setup fee, on any plan. It's how every club starts, not an
                upsell.
              </p>
              <a
                href={`mailto:${CONTACT_EMAIL}`}
                data-marketing-event="setup_contact_clicked"
                data-marketing-location="setup"
                class="mt-7 inline-flex items-center gap-1.5 text-[0.875rem] font-semibold text-stone-950 underline decoration-brand-700/35 underline-offset-4 transition hover:decoration-brand-700"
              >
                Talk to us about your season
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <ol class="grid gap-3 sm:grid-cols-2">
              {
                setupSteps.map((step, index) => (
                  <li
                    data-reveal
                    style={`--reveal-delay:${index * 70}ms`}
                    class="flex flex-col rounded-[1.1rem] border border-stone-950/9 bg-white/70 p-6 shadow-paper"
                  >
                    <span class="grid size-9 place-items-center rounded-full bg-brand-100 font-mono text-[0.6875rem] font-semibold text-brand-800">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="mt-6 font-serif text-[1.3rem] leading-[1.2] font-semibold tracking-[-0.03em] text-stone-950">
                      {step.title}
                    </h3>
                    <p class="mt-3 text-[0.8125rem] leading-[1.65] text-stone-600">
                      {step.body}
                    </p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section id="pricing" class="border-t border-stone-950/8 bg-white/68">
        <div class="mx-auto max-w-[74rem] px-5 py-20 sm:px-7 lg:px-8 lg:py-28">
          <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14">
            <div data-reveal>
              <div class={eyebrow}>Simple annual pricing</div>
              <h2
                class="mt-5 max-w-[13ch] font-serif text-[clamp(2.5rem,5vw,4.35rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-stone-950"
              >
                Unlimited members. No surprise tiers.
              </h2>
              <p
                class="mt-6 max-w-[42ch] text-[0.9375rem] leading-[1.7] text-stone-600"
              >
                Start with membership management, then add only what your club
                uses. Every add-on is free for your entire first year — and on
                Starter, you don't pay a dollar until your members start paying
                you.
              </p>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              {
                plans.map((plan, index) => (
                  <article
                    data-reveal
                    style={`--reveal-delay:${index * 80}ms`}
                    class={`relative flex flex-col rounded-[1.2rem] border p-6 ${plan.featured ? "border-stone-950 bg-stone-950 text-white shadow-paper-lg" : "border-stone-950/10 bg-[#faf9f7] text-stone-950 shadow-paper"}`}
                  >
                    {plan.featured && (
                      <span class="absolute top-4 right-4 rounded-full bg-brand-500/18 px-2.5 py-1 font-mono text-[0.5625rem] font-semibold tracking-[0.12em] text-brand-200 uppercase">
                        Best value
                      </span>
                    )}
                    {plan.slug === "starter" && (
                      <span class="absolute top-4 right-4 rounded-full bg-brand-500/12 px-2.5 py-1 font-mono text-[0.5625rem] font-semibold tracking-[0.12em] text-brand-800 uppercase">
                        $0 until members pay
                      </span>
                    )}
                    <div
                      class={`font-mono text-[0.625rem] font-semibold tracking-[0.12em] uppercase ${plan.featured ? "text-stone-400" : "text-stone-500"}`}
                    >
                      {plan.name}
                    </div>
                    <div class="mt-7 flex items-end gap-2">
                      <span class="font-serif text-[3.5rem] leading-none font-semibold tracking-[-0.055em]">
                        {plan.price}
                      </span>
                      <span
                        class={`pb-1 text-[0.75rem] ${plan.featured ? "text-stone-400" : "text-stone-500"}`}
                      >
                        /{plan.interval === "year" ? "yr" : "mo"}
                      </span>
                    </div>
                    <p
                      class={`mt-5 min-h-[4.8rem] text-[0.875rem] leading-[1.6] ${plan.featured ? "text-stone-400" : "text-stone-600"}`}
                    >
                      {plan.tagline}
                    </p>
                    <div
                      class={`mt-6 border-t pt-5 text-[0.8125rem] font-semibold ${plan.featured ? "border-white/12 text-white" : "border-stone-950/9 text-stone-800"}`}
                    >
                      {formatFee(plan.platformFeePercentage)}
                    </div>
                    <a
                      href={`${SIGNUP_URL}?plan=${plan.slug}`}
                      data-marketing-event="trial_started"
                      data-marketing-location={`pricing_${plan.slug}`}
                      class={`mt-6 inline-flex items-center justify-center rounded-full px-4 py-2.5 text-[0.8125rem] font-semibold transition hover:-translate-y-px motion-reduce:transform-none ${plan.featured ? "bg-white text-stone-950 hover:bg-stone-100" : "bg-stone-950 text-white hover:bg-stone-800"}`}
                    >
                      Start 45-day free trial
                    </a>
                  </article>
                ))
              }
            </div>
          </div>

          <div
            class="mt-14 grid gap-8 border-t border-stone-950/9 pt-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14"
          >
            <div>
              <h3
                class="font-serif text-[1.5rem] font-semibold tracking-[-0.03em] text-stone-950"
              >
                Included in every plan
              </h3>
              <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                {
                  baseFeatures.map((feature) => (
                    <div class="flex gap-3 text-[0.8125rem] leading-snug text-stone-600">
                      <>
                        <span class="text-brand-700">✓</span>
                        <span>{feature}</span>
                      </>
                    </div>
                  ))
                }
              </div>
            </div>

            <div>
              <h3
                class="font-serif text-[1.5rem] font-semibold tracking-[-0.03em] text-stone-950"
              >
                Add what your club needs
              </h3>
              <div
                class="mt-4 rounded-[0.9rem] border border-brand-700/15 bg-brand-500/8 px-4 py-3.5"
              >
                <p class="text-[0.875rem] font-semibold text-stone-950">
                  Every add-on is free for your entire first year.
                </p>
                <p class="mt-1 text-[0.8125rem] leading-[1.6] text-stone-600">
                  Turn everything on at signup, run a full season, and keep only
                  what your club uses — the flat annual prices below start in
                  year two.
                </p>
              </div>
              <div class="mt-6 grid gap-x-8 gap-y-0 sm:grid-cols-2">
                {
                  modules.map((module) => (
                    <div class="border-t border-stone-950/8 py-4">
                      <div class="flex items-start justify-between gap-3">
                        <span class="flex flex-wrap items-center gap-2">
                          <span class="text-[0.8125rem] font-semibold text-stone-800">
                            {module.name}
                          </span>
                          {module.badge && (
                            <span class="rounded-full bg-brand-600 px-1.5 py-0.5 font-mono text-[0.5625rem] font-semibold uppercase tracking-[0.08em] text-white">
                              {module.badge}
                            </span>
                          )}
                        </span>
                        <span class="shrink-0 font-mono text-[0.6875rem] font-medium text-brand-800">
                          {module.price}
                        </span>
                      </div>
                      <p class="mt-1.5 text-[0.75rem] leading-[1.55] text-stone-500">
                        {module.description}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        class="relative overflow-hidden border-t border-stone-950/8 bg-[#efe4d7]"
      >
        <div class="absolute inset-0 hero-wash opacity-70" aria-hidden="true">
        </div>
        <div
          class="relative mx-auto max-w-[74rem] px-5 py-20 text-center sm:px-7 lg:px-8 lg:py-28"
        >
          <div class={eyebrow}>Your next season can be calmer</div>
          <h2
            class="mx-auto mt-5 max-w-[16ch] font-serif text-[clamp(2.6rem,5.5vw,4.8rem)] leading-[0.95] font-semibold tracking-[-0.05em] text-balance text-stone-950"
          >
            Bring the club together in one workspace.
          </h2>
          <p
            class="mx-auto mt-6 max-w-[46ch] text-[1rem] leading-[1.7] text-stone-600"
          >
            Explore a complete sample club now, or start with your own roster.
            You’ll have 45 days to decide—no card and no pressure.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href={DEMO_LOGIN_URL}
              data-marketing-event="live_demo_clicked"
              data-marketing-location="final_cta"
              class={primaryButton}
            >
              Explore the live demo <span aria-hidden="true">→</span>
            </a>
            <a
              href={SIGNUP_URL}
              data-marketing-event="trial_started"
              data-marketing-location="final_cta"
              class={secondaryButton}
            >
              Start a 45-day free trial
            </a>
          </div>
          <p class="mt-6 text-[0.75rem] text-stone-500">
            Prefer a walkthrough? Email <a
              class="font-semibold text-stone-800 underline decoration-stone-400 underline-offset-4"
              href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
            >.
          </p>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
