          </div>

          <div
            class="mt-12 flex items-center gap-6 text-[0.75rem] text-stone-600"
          >
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-amber-600"></span>
              99.9% uptime
            </div>
            <span class="h-3 w-px bg-stone-300"></span>
            <div>500+ organizations</div>
            <span class="h-3 w-px bg-stone-300"></span>
            <div>Trusted by swim clubs, HOAs & clubs</div>
          </div>
        </div>

        <!-- Right — product screenshot -->
        <div class="flex items-center lg:col-span-7 lg:-mr-12 xl:-mr-24">
          <picture class="block w-full">
            <source srcset="/app-members.webp" type="image/webp" />
            <img
              src="/app-members.png"
              alt="Memberley Members dashboard showing active members, tiers, and invite link"
              width="1400"
              height="897"
              class="w-full rounded-lg border border-stone-300 bg-white shadow-sm"
              loading="eager"
              decoding="async"
