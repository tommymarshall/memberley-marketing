function perInterval(interval: "month" | "year"): string {
  return interval === "year" ? "/yr" : "/mo";
}

function formatPercent(value: number): string {
  return Number.isInteger(value)
    ? `${value}%`
    : `${value.toFixed(2).replace(/\.?0+$/, "")}%`;
}

function feeLabel(value: number): string {
  return value > 0 ? `${formatPercent(value)} per payment` : "No platform fees";
}

const marketingMeta: Record<
  string,
  { featured: boolean; cta: string; tagline: string }
> = {
  starter: {
    featured: false,
    cta: "Start free trial",
    tagline:
      "Everything you need to run the club online: no annual fee, 3% per payment.",
  },
  community: {
    featured: true,
    cta: "Start free trial",
    tagline:
      "Everything in Starter with zero payment fees. Keep 100% of your dues.",
  },
};

const fallbackPlans: MarketingPlan[] = [
  {
    slug: "starter",
    name: "Starter",
    price: "$0",
    interval: "year",
    tagline: marketingMeta.starter.tagline,
    featured: false,
    cta: "Start free trial",
    platformFeePercentage: 3,
  },
  {
    slug: "community",
    name: "Community",
    price: "$500",
    interval: "year",
    tagline: marketingMeta.community.tagline,
    featured: true,
    cta: "Start free trial",
    platformFeePercentage: 0,
  },
];

let plans: MarketingPlan[] = fallbackPlans;

// Herd serves *.test on a self-signed cert; relax TLS verification only when
// targeting a local Herd URL so devs can preview live pricing during build.
const previousTlsReject = process.env.NODE_TLS_REJECT_UNAUTHORIZED;
const isLocalHerd = APP_URL.includes(".test");
if (isLocalHerd) {
  process.env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
}

try {
  const res = await fetch(`${APP_URL}/api/v1/plans`, {
    headers: { Accept: "application/json" },
  });
  if (res.ok) {
    const json = (await res.json()) as { data: ApiPlan[] };
    // Only trust the API when it actually returns plans — an empty array
    // (e.g. before the app is deployed with the new catalog) should fall back
    // to the hardcoded plans below rather than render an empty pricing grid.
    if (Array.isArray(json.data) && json.data.length > 0) {
      plans = json.data.map((p): MarketingPlan => {
        // The Community plan was named "Base" until 2026-07. The API derives
        // the slug from the name, so a build against a not-yet-redeployed app
        // still returns base/Base — normalize so this page renders the new
        // name and keeps the plan's featured styling either way.
        const slug = p.slug === "base" ? "community" : p.slug;
        const name = p.name === "Base" ? "Community" : p.name;
        const meta = marketingMeta[slug] ?? {
          featured: false,
          cta: "Start free trial",
          tagline: p.description ?? "",
        };
        return {
          slug,
          name,
          price: p.price_formatted,
          interval: p.billing_interval,
          tagline: meta.tagline,
          featured: meta.featured,
          cta: meta.cta,
          platformFeePercentage: Number(p.platform_fee_percentage ?? 0),
        };
      });
    } else {
      console.warn("Plans API returned no plans; using fallback pricing.");
    }
  } else {
    console.warn(`Plans API returned ${res.status}; using fallback pricing.`);
  }
} catch (err) {
  console.warn("Plans API fetch failed; using fallback pricing.", err);
} finally {
  if (isLocalHerd) {
    if (previousTlsReject === undefined) {
      delete process.env.NODE_TLS_REJECT_UNAUTHORIZED;
    } else {
      process.env.NODE_TLS_REJECT_UNAUTHORIZED = previousTlsReject;
    }
  }
}

