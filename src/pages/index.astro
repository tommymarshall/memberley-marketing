<Layout>
  <div class="min-h-dvh bg-stone-50 font-sans text-stone-900 antialiased">
    <!-- Nav -->
    <header
      class="sticky top-0 z-50 border-b border-stone-300 bg-stone-50/90 backdrop-blur-sm"
    >
      <div
        class="mx-auto flex h-14 max-w-[80rem] items-center justify-between px-6 lg:px-8"
      >
        <a href="/" aria-label="Homepage" class="flex items-center gap-2">
          <img
            src="/memberley-amper-light.svg"
            alt=""
            width="24"
            height="24"
            class="size-6"
            loading="eager"
            decoding="async"
          />
          <span
            class="text-[0.9375rem] font-semibold tracking-tight text-stone-900"
          >
            Memberley
          </span>
          <span
            class="ml-2 rounded-sm border border-stone-300 px-1.5 py-0.5 font-mono text-[0.625rem] text-stone-600"
          >
            v1.0
          </span>
        </a>

        <nav
          class="hidden items-center gap-7 text-[0.8125rem] text-stone-600 md:flex"
        >
          <a href="#features" class="transition hover:text-stone-900"
            >Features</a
          >
          <a href="#compare" class="transition hover:text-stone-900">Compare</a>
          <a href="#pricing" class="transition hover:text-stone-900">Pricing</a>
          <a href="#docs" class="transition hover:text-stone-900">Help</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            id="nav-signin"
            href={LOGIN_URL}
            class="text-[0.8125rem] text-stone-600 transition hover:text-stone-900"
          >
            Sign in
          </a>
          <a
            id="nav-cta"
            href={SIGNUP_URL}
            class={`inline-flex items-center gap-2 rounded-sm px-4 py-2 text-[0.8125rem] font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 ${primaryBtn}`}
          >
            Register
          </a>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="overflow-hidden border-b border-stone-300">
      <div
        class="mx-auto grid max-w-[80rem] grid-cols-1 gap-16 px-6 pt-10 pb-24 lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-20"
