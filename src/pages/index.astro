            Memberley
          </span>
          <span
            class="ml-2 rounded-sm border border-stone-300 px-1.5 py-0.5 font-mono text-[0.625rem] text-stone-600"
          >
            v1.0
          </span>
        </a>

        <nav
          class="hidden items-center gap-7 text-[0.8125rem] text-stone-600 md:flex"
        >
          <a href="#features" class="transition hover:text-stone-900"
            >Features</a
          >
          <a href="#how" class="transition hover:text-stone-900">How it works</a
          >
          <a href="#compare" class="transition hover:text-stone-900">Compare</a>
          <a href="#pricing" class="transition hover:text-stone-900">Pricing</a>
          <a href="#docs" class="transition hover:text-stone-900">Help</a>
        </nav>

        <div class="flex items-center gap-4">
          <a
            id="nav-signin"
            href={LOGIN_URL}
            class="text-[0.8125rem] text-stone-600 transition"
          >
            <script src={`${APP_URL}/embed.js`} async is:inline></script>
            <button data-memberley-org="camelot-pool">Memberley sign in</button>
          </a>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="overflow-hidden border-b border-stone-300">
      <div
        class="mx-auto grid max-w-[80rem] grid-cols-1 gap-16 px-6 py-24 lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-20"
      >
        <div class="lg:col-span-5">
          <div
            class="mb-8 inline-flex items-center gap-2 rounded-full border border-stone-300 bg-stone-100 py-1 pr-3 pl-1"
          >
            <span
              class="flex items-center gap-1.5 rounded-full bg-amber-700 px-2 py-0.5 text-[0.625rem] font-medium tracking-wide text-white uppercase"
            >
              <span class="size-1.5 rounded-full bg-white"></span>
              New
            </span>
            <span class="text-[0.75rem] text-stone-700">
              Classes, email campaigns, and waivers are live · SMS in beta →
            </span>
          </div>

          <h1
            class={`max-w-[20ch] text-[clamp(3rem,6vw,5.25rem)] leading-[0.95] text-balance ${display} text-stone-900`}
          >
            Run your community like it runs itself.
          </h1>

          <p
            class="mt-8 max-w-[52ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            Memberships, reservations, payments, classes, comms, and front-desk
            check-ins — in one calm workspace built for the person actually
            running the club.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class={`group inline-flex items-center gap-2 rounded-sm py-2.5 pr-5 pl-5 text-[0.875rem] font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 ${primaryBtn}`}
            >
              Start free trial
              <span class="transition group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href="#how"
              class={`inline-flex items-center gap-2 rounded-sm py-2.5 pr-5 pl-5 text-[0.875rem] font-medium transition ${secondaryBtn}`}
            >
              See how it works
