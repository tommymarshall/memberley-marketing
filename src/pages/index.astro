        </div>

        <p class="mt-6 font-mono text-[0.75rem] tracking-wide text-stone-600">
          * 14-day free trial on all plans. No card required. Cancel anytime.
        </p>
      </div>
    </section>

    <!-- Signup CTA -->
    <section class="bg-stone-900 text-stone-50">
      <div
        class="mx-auto grid max-w-[80rem] grid-cols-1 gap-16 px-6 py-24 lg:grid-cols-12 lg:px-8"
      >
        <div class="col-span-5">
          <div
            class="font-mono text-[0.6875rem] font-medium tracking-wide text-amber-400 uppercase"
