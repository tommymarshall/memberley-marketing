                        <div class="mt-8 flex items-center gap-3">
                            <div
                                class="flex size-10 items-center justify-center rounded-sm bg-stone-200 text-[0.75rem] font-semibold text-stone-700"
                            >
                                KP
                            </div>
                            <div>
                                <div
                                    class="text-[0.9375rem] font-semibold text-stone-900"
                                >
                                    Karen Paulson
                                </div>
                                <div class="text-[0.8125rem] text-stone-600">
                                    GM, Lakeside Swim Club
                                </div>
                            </div>
                        </div>
                    </div>
                    <blockquote
                        class={`relative col-span-8 text-[clamp(1.5rem,2.5vw,2rem)] leading-[1.25] text-balance ${display} text-stone-900 before:absolute before:inline before:-translate-x-full before:content-['\\201C'] after:inline after:content-['\\201D']`}
                    >
                        Before Memberley I spent four hours a week chasing dues
                        and answering the same reservation emails. Now it just
                        happens — and I can finally be at the pool instead of
                        behind the desk.
                    </blockquote>
                </div>
            </div>
        </section>

        <!-- Pricing -->
        <section id="pricing" class="border-b border-stone-300 bg-stone-50">
            <div class="mx-auto max-w-[80rem] px-6 py-24 lg:px-8">
                <div class="mb-14 max-w-[48ch]">
                    <div class={eyebrow}>§ Pricing</div>
                    <h2
                        class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
                    >
                        Flat pricing. No per-seat games.
                    </h2>
                </div>

                <div
                    class="grid grid-cols-1 divide-y divide-stone-300 border border-stone-300 md:grid-cols-3 md:divide-x md:divide-y-0"
                >
                    {
                        plans.map((p) => (
                            <div class="relative flex flex-col justify-between p-8">
                                {p.featured && (
                                    <span class="absolute top-6 right-6 rounded-sm bg-amber-700 px-2 py-0.5 font-mono text-[0.625rem] font-medium tracking-wide text-white uppercase">
                                        Recommended
                                    </span>
                                )}
                                <div>
                                    <div class="font-mono text-[0.6875rem] tracking-wide text-stone-600 uppercase">
                                        {p.name}
                                    </div>
                                    <div class="mt-5 flex items-baseline gap-1">
                                        <span
                                            class={`text-[3rem] leading-none ${display} text-stone-900 tabular-nums`}
                                        >
                                            {p.price}
                                        </span>
                                        <span class="text-[0.875rem] text-stone-600">
                                            /mo
                                        </span>
                                    </div>
                                    <ul
                                        role="list"
                                        class="mt-8 space-y-3 border-t border-stone-300 pt-6"
                                    >
                                        {p.feats.map((f) => (
                                            <li class="flex items-start gap-2.5 text-[0.875rem] text-stone-600">
                                                <svg
                                                    class="mt-0.5 size-4 h-lh shrink-0 text-amber-700"
                                                    viewBox="0 0 16 16"
                                                    fill="none"
                                                >
                                                    <path
                                                        d="M3 8.3l3 3 7-7"
                                                        stroke="currentColor"
                                                        stroke-width="1.5"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    />
                                                </svg>
                                                {f}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                                <a
                                    href={SIGNUP_URL}
                                    class={`mt-8 block rounded-sm py-2.5 text-center text-[0.875rem] font-medium transition ${p.featured ? 'bg-stone-900 text-stone-50 hover:bg-stone-800' : 'border border-stone-300 text-stone-900 hover:border-stone-400 hover:bg-stone-100'}`}
                                >
                                    {p.cta}
                                </a>
                            </div>
                        ))
                    }
                </div>

                <p
                    class="mt-6 font-mono text-[0.75rem] tracking-wide text-stone-600"
                >
                    * 14-day free trial on all plans. No card required. Cancel
                    anytime.
                </p>
            </div>
        </section>

        <!-- Signup CTA -->
        <section class="bg-stone-900 text-stone-50">
            <div
                class="mx-auto grid max-w-[80rem] grid-cols-1 gap-16 px-6 py-24 lg:grid-cols-12 lg:px-8"
            >
                <div class="col-span-5">
                    <div
                        class="font-mono text-[0.6875rem] font-medium tracking-wide text-amber-400 uppercase"
                    >
                        § Start
                    </div>
                    <h2
                        class={`mt-5 max-w-[18ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
                    >
                        Open your doors in under an hour.
                    </h2>
                    <p
                        class="mt-6 max-w-[44ch] text-[1rem] leading-relaxed text-stone-400"
                    >
                        Create your organization, set up your membership tiers,
                        and share the signup link with your members. That&rsquo;s
                        the whole thing.
                    </p>

                    <ul
                        role="list"
                        class="mt-10 space-y-3 border-t border-stone-800 pt-8"
                    >
                        {
                            signupPerks.map((i) => (
                                <li class="flex items-center gap-3 text-[0.875rem] text-stone-300">
                                    <span class="font-mono text-amber-400">
                                        →
                                    </span>
                                    {i}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="col-span-7">
                    <div
                        class="rounded-lg border border-stone-800 bg-stone-950 p-8"
                    >
                        <div class="mb-6 flex items-center justify-between">
                            <span
                                class="font-mono text-[0.75rem] tracking-wide text-stone-400 uppercase"
                            >
                                Create organization
                            </span>
                            <span
                                class="rounded-sm bg-amber-400/15 px-2 py-0.5 font-mono text-[0.625rem] font-medium tracking-wide text-amber-400 uppercase"
                            >
                                Free trial
                            </span>
                        </div>

                        <p class="mb-8 text-[0.875rem] leading-relaxed text-stone-400">
                            Get started in under a minute — we&rsquo;ll walk you
                            through organization setup, tiers, and your first
                            signup link.
                        </p>

                        <a
                            href={SIGNUP_URL}
                            class="block w-full rounded-sm bg-amber-700 py-3 text-center text-[0.875rem] font-semibold text-white transition hover:bg-amber-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
                        >
                            Create my organization →
                        </a>

                        <p
                            class="mt-6 text-center font-mono text-[0.75rem] text-stone-500"
                        >
                            Already have an account?{' '}
                            <a
                                href={LOGIN_URL}
                                class="text-amber-400 hover:text-amber-300"
                            >
                                sign in
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="border-t border-stone-300 bg-stone-50">
            <div class="mx-auto max-w-[80rem] px-6 py-12 lg:px-8">
                <div
                    class="grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]"
                >
                    <div>
                        <div class="flex items-center gap-2">
                            <span
                                class="flex size-6 items-center justify-center rounded-sm bg-stone-900 text-[0.625rem] font-semibold text-amber-400"
                            >
                                M
                            </span>
                            <span
                                class="text-[0.9375rem] font-semibold tracking-tight text-stone-900"
                            >
                                Memberley
                            </span>
                        </div>
                        <p
                            class="mt-4 max-w-[30ch] text-[0.8125rem] leading-relaxed text-stone-600"
                        >
                            The calm, all-in-one workspace for the people who
                            run clubs, pools, and HOAs.
                        </p>
                    </div>
                    {
                        footerCols.map((col) => (
                            <div>
                                <div class="mb-4 font-mono text-[0.6875rem] font-medium tracking-wide text-stone-600 uppercase">
                                    {col.t}
                                </div>
                                <ul role="list" class="space-y-2.5">
                                    {col.links.map((l) => (
                                        <li>
                                            <a
                                                href={l === 'Terms' ? '/terms' : '#'}
                                                class="text-[0.8125rem] font-normal text-stone-600 transition"
                                            >
                                                {l}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
                <div
                    class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-stone-300 pt-6 text-[0.75rem] text-stone-600 md:flex-row md:items-center"
                >
                    <span>© 2026 Memberley, Inc.</span>
                    <span class="flex items-center gap-2 font-mono">
                        <span class="size-1.5 rounded-full bg-amber-600"></span>
                        All systems operational
                    </span>
                </div>
            </div>
        </footer>
    </div>

    <script define:vars={{ appUrl: APP_URL }}>
        (function () {
            function applyAuthenticatedNav() {
                var signin = document.getElementById('nav-signin');
                var cta = document.getElementById('nav-cta');
                if (!signin || !cta || window.__ML_AUTHENTICATED !== true) {
                    return;
                }
                signin.remove();
                cta.textContent = 'Dashboard';
                cta.setAttribute('href', appUrl + '/dashboard');
            }

            window.__ML_AUTHENTICATED = false;
            var probe = document.createElement('script');
            probe.src = appUrl + '/marketing/session.js';
            probe.async = true;
            probe.onload = applyAuthenticatedNav;
            probe.onerror = function () {};
            document.head.appendChild(probe);
        })();
    </script>
</Layout>
