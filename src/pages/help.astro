---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  CONTACT_EMAIL,
  DEMO_LOGIN_URL,
  DOCS_URL,
  SIGNUP_URL,
  TRIAL_CTA_LABEL,
  TRIAL_TERMS,
} from "../config/site";
import {
  display,
  eyebrow,
  eyebrowOnDark,
  primaryButtonOnDark,
  secondaryButtonOnDark,
} from "../config/ui";

// An answer can end with one link — the demo, the docs — rendered as a real
// anchor under the text rather than a bare URL the reader has to retype.
type Faq = { q: string; a: string; link?: { href: string; label: string } };
type FaqGroup = { title: string; faqs: Faq[] };

const faqGroups: FaqGroup[] = [
  {
    title: "Getting started",
    faqs: [
      {
        q: "What is Memberley?",
        a: "Memberley runs the day-to-day of a neighborhood pool or swim & tennis club — memberships and dues, facility reservations, front-desk check-in, classes and programs, and member communications — in one workspace. HOAs with a pool or courts and private clubs run on it the same way.",
      },
      {
        q: "How long does setup take?",
        a: "Creating your organization takes about a minute. Connecting your own Stripe account takes about ten. Most clubs set up their tiers, import their roster, and share their signup link in an afternoon. Every plan starts with a 45-day free trial — no card required.",
      },
      {
        q: "Can I see it before signing up?",
        a: "Yes. The live demo is a full working organization you can click through — no account needed.",
        link: { href: DEMO_LOGIN_URL, label: "Open the live demo" },
      },
      {
        q: "How do I get my members in?",
        a: "Three ways: import your whole roster from a CSV in one upload, share a single invite link that drops new members onto your default tier, or hand out join codes. Most clubs are fully migrated in an afternoon. If you’d rather not do it yourself, we will — see the next question.",
      },
      {
        q: "Will you set our season up for us?",
        a: "Yes, free with every club and on every plan — no setup fee. Send us your roster and what you charged last year and we’ll move your members and households over, build your season with its tiers, dues, family pricing, prorating, and installments, load your waivers and the custom fields you collect at registration, and configure facilities, reservation rules, guest passes, and any classes or camps you run. Then we walk your board through it before you open registration.",
      },
      {
        q: "Can we track our own member details?",
        a: "Yes — custom member fields let you collect club-specific details (shirt sizes, emergency contacts, parking stickers, gate tags) at signup or on member profiles, then use them in roster filters, columns, and CSV exports. Classes and programs can ask their own registration questions at enrollment, and fields marked sensitive are stored encrypted and kept out of roster columns and exports.",
      },
    ],
  },
  {
    title: "Pricing & billing",
    faqs: [
      {
        q: "What does Memberley cost?",
        a: "Two plans, both with unlimited members: Starter is $0/yr with a 3% fee per payment processed through Memberley. Community is $500/yr with zero payment fees. Add-on modules (reservations, front desk & check-in, point of sale, communications, branded site & embed, classes & events, assessments & capital fees) are free for your entire first year, then flat-priced at $100–$250 per year each. Standard Stripe processing fees apply on every plan, as with any provider.",
      },
      {
        q: "Which plan should we pick?",
        a: "A rule of thumb: if your club collects more than about $17,000 a year through Memberley, Community’s flat $500 costs less than Starter’s 3%, and you keep 100% of your dues. Smaller clubs usually start on Starter and upgrade when the math flips.",
      },
      {
        q: "What are add-on modules?",
        a: "Optional features billed flat per year, so you pay for only what your club uses. Every module is free for your entire first year — turn them all on, run a season, and keep the ones that earned their place. You can switch modules on or off as your needs change.",
      },
      {
        q: "Can we bill capital contributions, initiation fees, or special assessments?",
        a: "Yes — the Assessments & Capital Fees module ($150/yr, free your first year) handles the charges that live outside normal dues: a capital contribution billed only during a member’s first few membership years, a one-time initiation fee for new members, and special assessments issued to everyone who is a member on a given date. Memberley counts each household’s membership year from the day they were first accepted (time on the waitlist never counts), adds the charge beside their dues, and stops automatically when the window ends — no moving members between tiers. Every charge is itemized on renewal emails, the member’s account, receipts, and reports.",
      },
      {
        q: "Can we cancel?",
        a: "Anytime. The trial requires no card, and there are no long-term contracts or cancellation fees.",
      },
    ],
  },
  {
    title: "Payments",
    faqs: [
      {
        q: "Where does members’ money go?",
        a: "Into your own Stripe account, connected through Stripe Connect. Members pay your club directly, and payouts typically reach your bank in 1–2 business days — no middleman holding your funds.",
      },
      {
        q: "Do you support ACH bank payments?",
        a: "Yes. Members can pay dues by card or ACH bank transfer, and receipts go out automatically on every charge. Your club can also pay its own Memberley subscription by ACH.",
      },
      {
        q: "Can members pay automatically or in installments?",
        a: "Both. Members can opt into autopay for renewals, and clubs can offer installment payment plans. Discount codes handle early-bird or promotional pricing, and automatic late fees can be applied to overdue dues.",
      },
    ],
  },
  {
    title: "Switching & support",
    faqs: [
      {
        q: "We’re on Member Splash, PoolDues, or CourtReserve — how hard is switching?",
        a: "We migrate you for free: send us your current roster and we’ll import it, set up your branded portal, and have you live before registration opens. Most clubs switch in the off-season so everything is ready for next year.",
      },
      {
        q: "Can we keep our existing website?",
        a: "Yes. Memberley’s member portal embeds into the website you already have, themed to your colors, fonts, and logo — you don’t move your web presence onto our servers.",
      },
      {
        q: "How do we reach a human?",
        a: "Write tommy@memberley.com or call the founder Tommy at (703) 895-6939. Memberley is based in Northern Virginia, and we’ll happily meet your board in person to walk through setup and migration.",
      },
    ],
  },
];

const allFaqs = faqGroups.flatMap((g) => g.faqs);
---

<Layout
  title="Help & FAQ | Memberley"
  description="Answers about Memberley pricing, plans and modules, Stripe payments and payouts, ACH, migrations from Member Splash or PoolDues, and how to reach us."
>
  <div class="min-h-dvh paper-light font-sans text-stone-900 antialiased">
    <SiteHeader />

    <main id="main">
    <!-- Hero -->
    <section class="site-header-offset hero-wash border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-20 lg:px-8">
        <div class="max-w-[60ch]">
          <div class={eyebrow}>Help</div>
          <h1
            class={`mt-5 max-w-[18ch] text-[clamp(2.5rem,4.5vw,4rem)] leading-[1] text-balance ${display} text-stone-900`}
          >
            Questions, answered plainly.
          </h1>
          <p
            class="mt-6 max-w-[54ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            Everything boards ask before they switch: pricing, payments,
            migration, and what happens to the website you already have.
            Already using Memberley? The full product documentation lives at
            <a
              href={DOCS_URL}
              class="font-medium text-stone-900 underline decoration-stone-400 underline-offset-2 transition hover:decoration-stone-900"
              >docs.memberley.com</a
            >. Can’t find your answer? Write
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="font-medium text-stone-900 underline decoration-stone-400 underline-offset-2 transition hover:decoration-stone-900"
              >{CONTACT_EMAIL}</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ groups -->
    {
      faqGroups.map((g) => (
        <section class="border-b border-stone-950/10">
          <div class="mx-auto max-w-[74rem] px-6 py-16 lg:px-8">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
              <div class="lg:col-span-3">
                <h2 class={`text-[1.375rem] ${display} text-stone-900`}>
                  {g.title}
                </h2>
              </div>
              <dl class="divide-y divide-stone-950/10 lg:col-span-9">
                {g.faqs.map((f) => (
                  <div class="py-6 first:pt-0 last:pb-0">
                    <dt class="text-[1rem] font-semibold text-stone-900">
                      {f.q}
                    </dt>
                    <dd class="mt-2.5 max-w-[65ch] text-[0.9375rem] leading-relaxed text-stone-600">
                      {f.a}
                      {f.link && (
                        <a
                          href={f.link.href}
                          class="mt-2 inline-flex items-center gap-1.5 font-medium text-stone-900 underline decoration-stone-400 underline-offset-4 transition hover:decoration-stone-900"
                        >
                          {f.link.label} <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </section>
      ))
    }

    <!-- Contact / CTA -->
    <section class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-20 lg:px-8">
        <div class="max-w-[44ch]">
          <div class={eyebrowOnDark}>Still deciding?</div>
          <h2
            class={`mt-5 text-[clamp(2rem,3.5vw,3rem)] leading-[1.05] text-balance ${display} text-stone-50`}
          >
            Talk to a person, or just try it.
          </h2>
          <p
            class="mt-6 max-w-[46ch] text-[1rem] leading-relaxed text-stone-400"
          >
            Write Tommy and he&rsquo;ll walk your board through setup and
            migration, or explore the live demo and start your 45-day free
            trial whenever you&rsquo;re ready.
          </p>
        </div>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`mailto:${CONTACT_EMAIL}`} class={primaryButtonOnDark}>
            Email Tommy
          </a>
          <a href={DEMO_LOGIN_URL} class={secondaryButtonOnDark}>
            Explore the live demo
          </a>
          <a
            href={SIGNUP_URL}
            class="inline-flex items-center justify-center gap-2 px-5 py-3 text-[0.875rem] font-medium text-stone-300 transition hover:text-stone-50"
          >
            {TRIAL_CTA_LABEL} <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="mt-4 font-mono text-[0.6875rem] tracking-[0.04em] text-stone-500">
          {CONTACT_EMAIL} · (703) 895-6939 · {TRIAL_TERMS}
        </p>
      </div>
    </section>
    </main>

    <SiteFooter />
  </div>

  <!-- FAQ structured data for rich results -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: allFaqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>
