---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComparisonHeroVisual from "../../components/ComparisonHeroVisual.astro";
import ComparisonTableHead from "../../components/ComparisonTableHead.astro";
import { DEMO_URL, SIGNUP_URL } from "../../config/site";

// ── Class tokens (inlined paper theme, matches index.astro) ──────────────────
const eyebrow =
  "font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase";
const display = "font-serif font-semibold tracking-tight";
const primaryBtn =
  "bg-stone-900 text-stone-50 shadow-btn hover:bg-stone-800 focus-visible:outline-brand-600";
const secondaryBtn =
  "border border-stone-950/15 bg-white text-stone-900 hover:border-stone-950/30 hover:bg-stone-100";

// ── Head-to-head ─────────────────────────────────────────────────────────────
// Competitor details as published by ClubExpress (clubexpress.com pricing
// sheet + help center, 2026): 42¢/member/mo sliding scale, $150 basic setup,
// website packs $960–$4,850, cards 2.99% + 20¢ (own merchant allowed),
// QuickBooks $20/mo, texting 2–4¢/message, 60-day trial. Re-verify before
// publishing — comparative claims must stay truthful.
// Cell types: string = literal · true = ✓ · false = ✕ · null = — (not advertised).
type Cell = string | boolean | null;

const rows: { label: string; memberley: Cell; competitor: Cell }[] = [
  {
    label: "Starting price",
    memberley: "$0/yr + 3%, or $500/yr with no payment fees",
    competitor: "42¢ / member / month",
  },
  {
    label: "Unlimited members included",
    memberley: true,
    competitor: "Per-member metering",
  },
  {
    label: "One-time setup fee",
    memberley: "None",
    competitor: "$150 · site build-outs $960–$4,850",
  },
  {
    label: "Payments",
    memberley: "Your own Stripe · 1–2 day payouts",
    competitor: "2.99% + 20¢, or your own merchant",
  },
  {
    label: "Member portal embeds in the website you already have",
    memberley: true,
    competitor: "Hosted on ClubExpress",
  },
  {
    label: "White-label branding on portal & emails",
    memberley: true,
    competitor: null,
  },
  {
    label: "Built-in email broadcasts & member segments",
    memberley: true,
    competitor: true,
  },
  {
    label: "SMS broadcasts & one-to-one texts",
    memberley: true,
    competitor: "2–4¢ per text + monthly number fee",
  },
  {
    label: "QuickBooks integration",
    memberley: true,
    competitor: "$20 / month add-on",
  },
  { label: "Online dues & auto-renewal", memberley: true, competitor: true },
  {
    label: "Guest passes & QR gate check-in",
    memberley: true,
    competitor: null,
  },
  {
    label: "Reservations (lanes / courts / rooms)",
    memberley: true,
    competitor: "Paid add-on module",
  },
  {
    label: "Point of sale & snack bar",
    memberley: true,
    competitor: "Paid add-on module",
  },
  {
    label: "Digital waivers with e-signature",
    memberley: true,
    competitor: null,
  },
  {
    label: "Classes, lessons & programs",
    memberley: true,
    competitor: "Events & registration",
  },
  {
    label: "Free white-glove migration",
    memberley: true,
    competitor: "Data import with paid setup",
  },
];

const reasons = [
  {
    title: "Flat pricing, not a per-member meter",
    body: "ClubExpress bills 42¢ per member per month (sliding down as clubs grow), so a 300-member club pays roughly $1,370 a year before any extras. Memberley starts at $0/yr with unlimited members and a 3% payment fee, or $500/yr with no payment fees — either way, your roster is never a meter.",
  },
  {
    title: "No setup fee, no website packs",
    body: "ClubExpress charges $150 for basic setup, and its configured website build-outs run $960 to $4,850. Memberley has no setup fee at all — we import your roster and set up your branded portal for free.",
  },
  {
    title: "The good stuff isn't an add-on",
    body: "On ClubExpress, QuickBooks sync is $20/month, texting is metered per message, and modules like point of sale and resource scheduling carry their own one-time and monthly fees. Memberley's modules are flat-priced and free for your entire first year, and QuickBooks and Mailchimp sync are built in — no meters.",
  },
  {
    title: "Built this decade",
    body: "A fast, modern interface your board and your front desk can actually use on a phone or tablet at the gate — with payments landing in your own Stripe account, typically in your bank within 1–2 business days.",
  },
];

// Extras where Memberley goes further than ClubExpress's published feature set.
const builtInExtras: {
  title: string;
  desc: string;
  icon: string;
  badge?: string;
}[] = [
  {
    title: "Gate check-in & guest passes",
    desc: "QR check-in at the front desk, with guest passes that auto-charge the member's card on file.",
    icon: '<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/>',
  },
  {
    title: "SMS member texts",
    desc: "The Communications module includes 1,000 texts a month flat — broadcasts and one-to-one — not a per-message meter.",
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    title: "QuickBooks & Mailchimp",
    desc: "Native sync of dues and members — not a separate $20-a-month line item.",
    icon: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>',
  },
  {
    title: "Waivers & documents",
    desc: "E-sign reusable waiver templates with annual expiration and share a document library, exportable as signed PDFs.",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/>',
  },
  {
    title: "Embedded white-label portal",
    desc: "Drop the full member portal into your own website, themed to your colors, fonts, and logo.",
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: "Modern, mobile-ready UI",
    desc: "Run the front desk from a phone or tablet at the gate — fast, clean, nothing to install.",
    icon: '<rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/>',
  },
  {
    title: "Family & household accounts",
    desc: "Link a household under one roof and keep billing and guest passes straight.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];

const faqs = [
  {
    q: "Is Memberley a good ClubExpress alternative for pools and clubs?",
    a: "Yes — especially for clubs with a physical facility. Memberley covers online dues with auto-renewal, seasonal tiers, guest passes, QR gate check-in, reservations, waivers, and built-in email and SMS. ClubExpress is broad general-purpose club software, but facility operations like gate check-in and guest passes aren't part of its published feature set, and several of its modules carry separate fees.",
  },
  {
    q: "How does pricing compare to ClubExpress?",
    a: "ClubExpress bills per member per month — 42¢ for clubs up to 200 members, sliding down for larger clubs — plus a $150 basic setup fee, with website build-out packages from $960 to $4,850 and extra fees for modules like QuickBooks sync ($20/month) and texting (2–4¢ per message). Memberley starts at $0/yr with unlimited members and a 3% payment fee — or a $500/yr Community plan with zero payment fees — and add-on modules are flat-priced and free for your entire first year. Standard Stripe processing fees apply, as with any provider.",
  },
  {
    q: "Where does the money go when members pay?",
    a: "Into your own Stripe account, typically deposited to your bank in 1–2 business days. ClubExpress processes cards at 2.99% + 20¢ through its own payment system — though, to its credit, it also lets you bring your own merchant account.",
  },
  {
    q: "Can we keep our existing club website?",
    a: "Yes. Memberley's member portal embeds into the site you already have, themed to match. ClubExpress hosts your club website on its platform — hosting is included, but your web presence and your operations live with the same vendor.",
  },
  {
    q: "Can we switch in the middle of the season?",
    a: "You can switch anytime, but most clubs migrate in the off-season so everything is ready before registration opens. We import your roster for you either way — free, with no setup fee.",
  },
  {
    q: "Do you work with Northern Virginia pools?",
    a: "Yes — Memberley is based in Northern Virginia and we'll happily meet your board in person to walk through setup and migration.",
  },
];
---

<Layout
  title="ClubExpress Alternative for Pools & Clubs | Memberley"
  description="Looking for a ClubExpress alternative? Memberley runs dues, reservations, guest passes, and gate check-in — with unlimited members instead of per-member fees, no setup packs, payments to your own Stripe account, and free migration."
>
  <div class="min-h-dvh paper-light font-sans text-stone-900 antialiased">
    <SiteHeader />

    <!-- Hero -->
    <section class="site-header-offset hero-wash border-b border-stone-950/10">
      <div class="mx-auto grid max-w-[74rem] items-center gap-12 px-6 py-20 lg:grid-cols-[0.84fr_1.16fr] lg:px-8 lg:py-24">
        <div class="max-w-[60ch]">
          <div class={eyebrow}>§ ClubExpress alternative</div>
          <h1
            class={`mt-5 max-w-[18ch] text-[clamp(2.5rem,4vw,3.5rem)] leading-[1] text-balance ${display} text-stone-900`}
          >
            A ClubExpress alternative without the per-member meter.
          </h1>
          <p
            class="mt-7 max-w-[54ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            Dues, reservations, guest passes, and gate check-in in one modern
            workspace — with <strong>unlimited members</strong> instead of
            per-member fees, no setup packs, and payments into
            <strong>your</strong> Stripe account.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class={`group inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.875rem] font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 ${primaryBtn}`}
            >
              Start 45-day free trial
              <span class="transition group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href="#compare"
              class={`inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.875rem] font-medium transition ${secondaryBtn}`}
            >
              See the comparison
            </a>
          </div>
          <p class="mt-6 font-mono text-[0.75rem] tracking-wide text-stone-600">
            Free migration off ClubExpress · No setup fee · 45-day trial, no
            card
          </p>
        </div>
        <ComparisonHeroVisual
          competitor="ClubExpress"
          competitorLogo="/competitors/clubexpress.png"
          screenshot="/product/payments.webp"
          screenshotAlt="Memberley payments workspace"
        />
      </div>
    </section>

    <!-- Reasons -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>§ Why clubs switch</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Four reasons clubs move to Memberley.
          </h2>
        </div>
        <dl
          class="grid grid-cols-1 divide-y divide-stone-950/10 border-y border-stone-950/10 md:grid-cols-2 md:divide-x md:divide-y-0"
        >
          {
            reasons.map((r, i) => (
              <div
                class={`p-8 ${i >= 2 ? "md:border-t md:border-stone-950/10" : ""}`}
              >
                <dt class={`text-[1.375rem] ${display} text-stone-900`}>
                  {r.title}
                </dt>
                <dd class="mt-3 max-w-[50ch] text-[0.9375rem] leading-relaxed text-stone-600">
                  {r.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Head-to-head comparison -->
    <section id="compare" class="border-b border-stone-950/10 bg-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>§ Head to head</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Memberley vs. ClubExpress.
          </h2>
        </div>

        <div
          class="overflow-x-auto rounded-lg border border-stone-950/15 bg-white"
        >
          <table class="w-full border-collapse text-left">
            <thead>
              <ComparisonTableHead
                competitor="ClubExpress"
                competitorLogo="/competitors/clubexpress.png"
              />
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-stone-950/5 last:border-0">
                    <th class="p-3 align-middle text-[0.8125rem] font-medium text-stone-700 sm:p-4">
                      {row.label}
                    </th>
                    {[row.memberley, row.competitor].map((cell, i) => (
                      <td
                        class={`p-3 text-center align-middle sm:p-4 ${i === 0 ? "bg-brand-700/[0.04]" : ""}`}
                      >
                        {typeof cell === "string" ? (
                          <span class="text-[0.8125rem] text-stone-700">
                            {cell}
                          </span>
                        ) : cell === true ? (
                          <svg
                            class="mx-auto size-4 text-brand-700"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-label="Yes"
                          >
                            <path
                              d="M3 8.3l3 3 7-7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : cell === false ? (
                          <span
                            class="text-[0.875rem] text-stone-400"
                            aria-label="No"
                          >
                            ✕
                          </span>
                        ) : (
                          <span
                            class="text-stone-300"
                            aria-label="Not advertised"
                          >
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p
          class="mt-4 max-w-[75ch] font-mono text-[0.75rem] tracking-wide text-stone-500"
        >
          * ClubExpress pricing &amp; features as published by ClubExpress
          (clubexpress.com, 2026). “—” means not advertised by ClubExpress;
          verify current terms before relying on them.
        </p>

        <!-- Fair-play note -->
        <div
          class="mt-10 flex flex-col gap-3 rounded-lg border border-stone-950/15 bg-white p-6 md:flex-row md:gap-6"
        >
          <div
            class="font-mono text-[0.6875rem] tracking-wide text-stone-500 uppercase md:w-44 md:shrink-0"
          >
            Credit where due
          </div>
          <p class="text-[0.875rem] leading-relaxed text-stone-600">
            ClubExpress is genuinely deep software for general clubs and
            associations: website hosting, unlimited blast email, forums,
            committees, and unlimited tech support are all included, there's no
            long-term contract, and it lets you bring your own merchant
            account. The tradeoff is how the fees accumulate — per-member
            metering, setup and website packages, and separate charges for
            modules — and that it's built for associations in general, not for
            running a pool or club facility day to day.
          </p>
        </div>
      </div>
    </section>

    <!-- More built in -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>§ Beyond the basics</div>
          <h2
            class={`mt-5 max-w-[24ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            More that comes built in.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            The tools that show up as add-on fees or meters elsewhere are
            already part of Memberley.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-4">
          {
            builtInExtras.map((f) => (
              <div>
                <div class="mb-3 flex size-8 items-center justify-center rounded-sm bg-stone-100 text-brand-700 ring-1 ring-stone-950/10">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4"
                    aria-hidden="true"
                    set:html={f.icon}
                  />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[0.9375rem] font-semibold text-stone-900">
                    {f.title}
                  </span>
                  {f.badge && (
                    <span class="rounded-sm border border-brand-700/30 bg-brand-700/10 px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase">
                      {f.badge}
                    </span>
                  )}
                </div>
                <div class="mt-1.5 text-[0.8125rem] leading-relaxed text-stone-600">
                  {f.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>§ FAQ</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Switching questions, answered.
          </h2>
        </div>
        <dl class="divide-y divide-stone-950/10 border-y border-stone-950/10">
          {
            faqs.map((f) => (
              <div class="grid grid-cols-1 gap-3 py-8 md:grid-cols-12 md:gap-8">
                <dt class="text-[1.0625rem] font-semibold text-stone-900 md:col-span-5">
                  {f.q}
                </dt>
                <dd class="max-w-[60ch] text-[0.9375rem] leading-relaxed text-stone-600 md:col-span-7">
                  {f.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="max-w-[40ch]">
          <div
            class="font-mono text-[0.6875rem] font-medium tracking-wide text-brand-400 uppercase"
          >
            § Make the switch
          </div>
          <h2
            class={`mt-5 text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
          >
            Leave the meters and setup packs behind.
          </h2>
          <p
            class="mt-6 max-w-[46ch] text-[1rem] leading-relaxed text-stone-400"
          >
            Start a 45-day free trial and see your club in Memberley in
            minutes, or send us your ClubExpress roster and we'll set
            everything up for you, free, before next season.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class="inline-flex items-center gap-2 rounded-sm bg-brand-700 px-5 py-3 text-[0.875rem] font-semibold text-white transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            >
              Start 45-day free trial →
            </a>
            <a
              href={DEMO_URL}
              class="inline-flex items-center gap-2 rounded-sm border border-stone-700 px-5 py-3 text-[0.875rem] font-medium text-stone-200 transition hover:bg-stone-800"
            >
              Explore the live demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>

  <!-- FAQ structured data for rich results -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>
