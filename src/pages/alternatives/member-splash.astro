---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComparisonHeroVisual from "../../components/ComparisonHeroVisual.astro";
import ComparisonTableHead from "../../components/ComparisonTableHead.astro";
import {
  DEMO_LOGIN_URL,
  SIGNUP_URL,
  TRIAL_CTA_LABEL,
  TRIAL_TERMS,
} from "../../config/site";
import {
  display,
  eyebrow,
  eyebrowOnDark,
  primaryButton,
  primaryButtonOnDark,
  secondaryButton,
  secondaryButtonOnDark,
} from "../../config/ui";

// ── Head-to-head ─────────────────────────────────────────────────────────────
// Competitor details as published on membersplash.com (2026). Re-verify before
// publishing — comparative claims must stay truthful.
// Cell types: string = literal · true = ✓ · false = ✕ · null = — (n/a).
type Cell = string | boolean | null;

const rows: { label: string; memberley: Cell; competitor: Cell }[] = [
  {
    label: "Starting price",
    memberley: "$0/yr + 3% per payment, or $500/yr with no Memberley fee",
    competitor: "$2,000–$3,500 / year",
  },
  {
    label: "One-time setup fee",
    memberley: "None",
    competitor: "Optional $500–$1,000",
  },
  {
    label: "Payments",
    memberley: "Your own Stripe · 1–2 day payouts",
    competitor: "ECRYPT merchant account",
  },
  {
    label: "Member portal embeds in the website you already have",
    memberley: true,
    competitor: "Keep-your-site option",
  },
  {
    label: "White-label branding on portal & emails",
    memberley: true,
    competitor: null,
  },
  {
    label: "Built-in email broadcasts & member segments",
    memberley: true,
    competitor: true,
  },
  { label: "Free white-glove migration", memberley: true, competitor: true },
  {
    label: "Modern, mobile-ready interface",
    memberley: true,
    competitor: null,
  },
  // Member Splash’s published app is the front-desk check-in app (iOS, paired
  // with card-reader hardware) — per internal competitor research 2026-05, no
  // member-facing app found. Re-verify before publishing.
  {
    label: "Installs on members' phones as an app",
    memberley: true,
    competitor: "Front-desk check-in app only",
  },
  {
    label: "SMS broadcasts & one-to-one texts",
    memberley: true,
    competitor: "Top tier only",
  },
  {
    label: "QuickBooks & Mailchimp integrations",
    memberley: true,
    competitor: "Mailchimp · QB via CSV",
  },
  { label: "Classes, lessons & programs", memberley: true, competitor: true },
  {
    label: "Online dues & auto-renewal",
    memberley: true,
    competitor: "Auto-renew: future release",
  },
  // Initiation fees per membersplash.com/feature-overview/online-payment-processing (2026-08); no tenure-based or special-assessment billing found — re-verify before publishing.
  {
    label: "Capital fees & special assessments",
    memberley: "Tenure-based · one-time · initiation",
    competitor: "Initiation fee at signup",
  },
  { label: "Guest passes & QR check-in", memberley: true, competitor: true },
  { label: "Waitlist automation", memberley: true, competitor: true },
  {
    label: "Reservations (lanes / courts / rooms)",
    memberley: true,
    competitor: true,
  },
];

// Extras where Memberley goes further than Member Splash’s published feature set.
const builtInExtras: {
  title: string;
  desc: string;
  icon: string;
  badge?: string;
}[] = [
  {
    title: "SMS member texts",
    desc: "Reach members where they actually reply: broadcasts and one-to-one texts, right alongside everything else.",
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    title: "QuickBooks & Mailchimp",
    desc: "Native sync of dues and members — not just optional Mailchimp and manual QuickBooks reconciliation.",
    icon: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>',
  },
  {
    title: "Classes & programs",
    desc: "Publish a catalog of lessons, clinics, and camps with a public signup page and rosters — no second booking tool.",
    icon: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  },
  {
    title: "Waivers & documents",
    desc: "E-sign reusable waiver templates with annual expiration and share a document library, exportable as signed PDFs.",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/>',
  },
  {
    title: "Embedded white-label portal",
    desc: "Drop the full member portal into your own website, themed to your colors, fonts, and logo.",
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: "An app on your members' phones",
    desc: "Members add it to the home screen under your club’s name and colors, and it opens full screen — no app store, nothing to update. Same app runs the front desk from a phone or tablet at the gate.",
    icon: '<rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/>',
  },
  {
    title: "Family & household accounts",
    desc: "Link a household under one roof and keep billing and guest passes straight.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];

const reasons = [
  {
    title: "Keep your dues — and your brand",
    body: "Connect your own Stripe account in minutes. Members pay your club directly and payouts typically reach your bank in 1–2 business days. The portal and every email carry your logo and colors, not a vendor’s.",
  },
  {
    title: "No setup fee, lower yearly cost",
    body: "Member Splash runs $2,000–$3,500 a year before your first member pays, plus $500–$1,000 more if you want hands-on setup. Memberley starts at $0/yr with a 3% payment fee, and there’s nothing to set up.",
  },
  {
    title: "Built this decade",
    body: "A fast, modern interface your board and your front desk can actually use on a phone or tablet at the gate — not a dated dashboard.",
  },
  {
    title: "We move you over for free",
    body: "Send us your current roster and we import it, set up your branded portal, and have you live before registration opens next season. No spreadsheets, no downtime.",
  },
];

const faqs = [
  {
    q: "Is Memberley a good Member Splash alternative for neighborhood pools?",
    a: "Yes — Memberley is purpose-built for community and neighborhood pools: seasonal membership tiers, guest-pass auto-charge at the gate, QR-code check-in, waitlists, and online dues. The biggest differences are that dues settle to your own Stripe account, the member portal and emails are branded as your club, and there’s no setup fee.",
  },
  {
    q: "How does pricing compare to Member Splash?",
    a: "Member Splash publishes $2,000/yr (Essentials OS) to $3,500/yr (Premium OS), with hands-on setup available for an extra $500–$1,000. Memberley starts at $0/yr — unlimited members, no setup fee — with a 3% payment fee, or a $500/yr Community plan with zero payment fees; either way you add only the modules you need, and every module is free for your entire first year. Standard Stripe processing fees apply, as with any provider. Most neighborhood pools land well under what they’d pay Member Splash in year one.",
  },
  {
    q: "Where does the money go when members pay?",
    a: "Into your own Stripe account. You connect Stripe in under 10 minutes, and dues, renewals, and guest fees typically deposit to your bank in 1–2 business days — no middleman holding your funds.",
  },
  {
    q: "Can we keep our existing club website?",
    a: "Yes. Memberley’s member portal embeds into the site you already have, themed to match. You don’t have to move your website onto our servers.",
  },
  {
    q: "Does Memberley have a mobile app?",
    a: "Yes. Members and staff add Memberley to their phone’s home screen straight from the browser — it gets its own icon under your club’s name, opens full screen, and stays signed in, with nothing to download from an app store and no updates to install. Member Splash’s app is a check-in tool for staff; a Memberley household books a court, pays dues, and pulls up their check-in code from the same icon.",
  },
  {
    q: "Can Memberley bill our capital contribution and initiation fee?",
    a: "Yes. The Assessments & Capital Fees module ($150/yr, free your first year) bills a capital contribution only during a member’s first few membership years, a one-time initiation fee for new members, and special assessments to everyone who is a member on a given date. Memberley counts each household’s membership year from the day they were first accepted — waitlist time never counts — adds the charge beside their dues at renewal, and stops on its own when the window ends. Member Splash collects initiation fees at signup; the recurring, tenure-based part is what boards usually track by hand today.",
  },
  {
    q: "Can we switch in the middle of the season?",
    a: "You can switch anytime, but most clubs migrate in the off-season (fall through early spring) so everything is ready before registration opens. We handle the data import for you either way.",
  },
  {
    q: "Do you work with Northern Virginia pools?",
    a: "Yes — Memberley is based in Northern Virginia and we’ll happily meet your board in person to walk through setup and migration.",
  },
];
---

<Layout
  title="Member Splash Alternative for Neighborhood Pools | Memberley"
  description="Looking for a Member Splash alternative? Memberley runs your pool’s memberships, dues, guest passes, and check-in — with dues paid to your own Stripe account, your branding, no setup fee, and free migration."
>
  <div class="min-h-dvh paper-light font-sans text-stone-900 antialiased">
    <SiteHeader />
    <main id="main">

    <!-- Hero -->
    <section class="site-header-offset hero-wash border-b border-stone-950/10">
      <div class="mx-auto grid max-w-[74rem] items-center gap-12 px-6 py-20 lg:grid-cols-[0.84fr_1.16fr] lg:px-8 lg:py-24">
        <div class="max-w-[60ch]">
          <div class={eyebrow}>Member Splash alternative</div>
          <h1
            class={`mt-5 max-w-[20ch] text-[clamp(2.5rem,4vw,3.5rem)] leading-[1] text-balance ${display} text-stone-900`}
          >
            The modern Member Splash alternative for neighborhood pools.
          </h1>
          <p
            class="mt-7 max-w-[54ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            The same pool essentials (dues, guest passes, waitlists, QR
            check-in) without the four-figure yearly bill. Your members pay into <strong
              >your</strong
            > Stripe account, and the portal wears
            <strong>your</strong> brand, not ours.
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <a
              href={SIGNUP_URL}
              data-marketing-event="trial_started"
              data-marketing-location="alternative_hero"
              class={`group ${primaryButton}`}
            >
              {TRIAL_CTA_LABEL}
              <span class="transition group-hover:translate-x-0.5 motion-reduce:transform-none">→</span>
            </a>
            <a href="#compare" class={secondaryButton}>See the comparison</a>
          </div>
          <p class="mt-6 font-mono text-[0.75rem] tracking-wide text-stone-600">
            Free migration off Member Splash · No setup fee · 45-day trial, no
            card
          </p>
        </div>
        <ComparisonHeroVisual
          competitor="Member Splash"
          competitorLogo="/competitors/member-splash.png"
          screenshot="/product/check-in.webp"
          screenshotAlt="Memberley front-desk check-in workspace"
        />
      </div>
    </section>

    <!-- Reasons -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>Why pools switch</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Four reasons clubs move to Memberley.
          </h2>
        </div>
        <dl
          class="grid grid-cols-1 divide-y divide-stone-950/10 border-y border-stone-950/10 md:grid-cols-2 md:divide-x md:divide-y-0"
        >
          {
            reasons.map((r, i) => (
              <div
                class={`p-8 ${i >= 2 ? "md:border-t md:border-stone-950/10" : ""}`}
              >
                <dt class={`text-[1.375rem] ${display} text-stone-900`}>
                  {r.title}
                </dt>
                <dd class="mt-3 max-w-[50ch] text-[0.9375rem] leading-relaxed text-stone-600">
                  {r.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Head-to-head comparison -->
    <section id="compare" class="border-b border-stone-950/10 bg-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>Head to head</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Memberley vs. Member Splash.
          </h2>
        </div>

        <div
          class="overflow-x-auto rounded-lg border border-stone-950/15 bg-white"
        >
          <table class="w-full border-collapse text-left">
            <thead>
              <ComparisonTableHead
                competitor="Member Splash"
                competitorLogo="/competitors/member-splash.png"
              />
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-stone-950/5 last:border-0">
                    <th class="p-3 align-middle text-[0.8125rem] font-medium text-stone-700 sm:p-4">
                      {row.label}
                    </th>
                    {[row.memberley, row.competitor].map((cell, i) => (
                      <td
                        class={`p-3 text-center align-middle sm:p-4 ${i === 0 ? "bg-brand-700/[0.04]" : ""}`}
                      >
                        {typeof cell === "string" ? (
                          <span class="text-[0.8125rem] text-stone-700">
                            {cell}
                          </span>
                        ) : cell === true ? (
                          <svg
                            class="mx-auto size-4 text-brand-700"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-label="Yes"
                          >
                            <path
                              d="M3 8.3l3 3 7-7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : cell === false ? (
                          <span
                            class="text-[0.875rem] text-stone-400"
                            aria-label="No"
                          >
                            ✕
                          </span>
                        ) : (
                          <span class="text-stone-300" aria-label="Not offered">
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p
          class="mt-4 max-w-[75ch] font-mono text-[0.75rem] tracking-wide text-stone-500"
        >
          * Member Splash pricing &amp; features as published on
          membersplash.com (2026). “—” means not advertised by Member Splash;
          verify current terms before relying on them.
        </p>

        <!-- Fair-play note -->
        <div
          class="mt-10 flex flex-col gap-3 rounded-lg border border-stone-950/15 bg-white p-6 md:flex-row md:gap-6"
        >
          <div
            class="font-mono text-[0.6875rem] tracking-wide text-stone-500 uppercase md:w-44 md:shrink-0"
          >
            Credit where due
          </div>
          {/* "Since 2010" and the club count are as published on membersplash.com
              (verified 2026-06). Re-verify before publishing. */}
          <p class="text-[0.875rem] leading-relaxed text-stone-600">
            Member Splash has run neighborhood pools since 2010, and hundreds
            of clubs is real trust: its support team knows this world, and if
            you want one vendor to build and host your club website alongside
            memberships, they do that well. The difference is where things
            live. With Memberley your website stays where it is with the member
            portal embedded in it, dues settle to your own Stripe account, and
            email and SMS sit in the same workspace as the gate.
          </p>
        </div>
      </div>
    </section>

    <!-- More built in -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>Beyond the basics</div>
          <h2
            class={`mt-5 max-w-[24ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            More that comes built in.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            The tools most clubs end up bolting on separately are already part
            of Memberley.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-4">
          {
            builtInExtras.map((f) => (
              <div>
                <div class="mb-3 flex size-8 items-center justify-center rounded-sm bg-stone-100 text-brand-700 ring-1 ring-stone-950/10">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4"
                    aria-hidden="true"
                    set:html={f.icon}
                  />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[0.9375rem] font-semibold text-stone-900">
                    {f.title}
                  </span>
                  {f.badge && (
                    <span class="rounded-sm border border-brand-700/30 bg-brand-700/10 px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase">
                      {f.badge}
                    </span>
                  )}
                </div>
                <div class="mt-1.5 text-[0.8125rem] leading-relaxed text-stone-600">
                  {f.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>FAQ</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Switching questions, answered.
          </h2>
        </div>
        <dl class="divide-y divide-stone-950/10 border-y border-stone-950/10">
          {
            faqs.map((f) => (
              <div class="grid grid-cols-1 gap-3 py-8 md:grid-cols-12 md:gap-8">
                <dt class="text-[1.0625rem] font-semibold text-stone-900 md:col-span-5">
                  {f.q}
                </dt>
                <dd class="max-w-[60ch] text-[0.9375rem] leading-relaxed text-stone-600 md:col-span-7">
                  {f.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="max-w-[40ch]">
          <div class={eyebrowOnDark}>Make the switch</div>
          <h2
            class={`mt-5 text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
          >
            Leave the four-figure bill behind.
          </h2>
          <p
            class="mt-6 max-w-[46ch] text-[1rem] leading-relaxed text-stone-400"
          >
            Start your free trial and see your club in Memberley in minutes, or
            send us your Member Splash roster and we’ll set everything up for
            you, free, before next season.
          </p>
        </div>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href={SIGNUP_URL}
            data-marketing-event="trial_started"
            data-marketing-location="alternative_cta"
            class={primaryButtonOnDark}
          >
            {TRIAL_CTA_LABEL} <span aria-hidden="true">→</span>
          </a>
          <a
            href={DEMO_LOGIN_URL}
            data-marketing-event="live_demo_clicked"
            data-marketing-location="alternative_cta"
            class={secondaryButtonOnDark}
          >
            Explore the live demo
          </a>
        </div>
        <p class="mt-4 font-mono text-[0.6875rem] tracking-[0.04em] text-stone-500">
          {TRIAL_TERMS} · Free migration, no setup fee
        </p>
      </div>
    </section>

    </main>
    <SiteFooter />
  </div>

  <!-- FAQ structured data for rich results -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>
