---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComparisonHeroVisual from "../../components/ComparisonHeroVisual.astro";
import ComparisonTableHead from "../../components/ComparisonTableHead.astro";
import { DEMO_URL, SIGNUP_URL } from "../../config/site";

// ── Class tokens (inlined paper theme, matches index.astro) ──────────────────
const eyebrow =
  "font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase";
const display = "font-serif font-semibold tracking-tight";
const primaryBtn =
  "bg-stone-900 text-stone-50 shadow-btn hover:bg-stone-800 focus-visible:outline-brand-600";
const secondaryBtn =
  "border border-stone-950/15 bg-white text-stone-900 hover:border-stone-950/30 hover:bg-stone-100";

// ── Head-to-head ─────────────────────────────────────────────────────────────
// Competitor details as published on wildapricot.com (2026): contact-tier
// pricing from $66/mo at 100 contacts, 60-day trial, no setup fees, Personify
// Payments (AffiniPay) at 2.9% + 30¢. Re-verify before publishing —
// comparative claims must stay truthful.
// Cell types: string = literal · true = ✓ · false = ✕ · null = — (not advertised).
type Cell = string | boolean | null;

const rows: { label: string; memberley: Cell; competitor: Cell }[] = [
  {
    label: "Starting price",
    memberley: "$0/yr + 3%, or $500/yr with no payment fees",
    competitor: "From $66/mo (100-contact tier)",
  },
  {
    label: "Unlimited members included",
    memberley: true,
    competitor: "Priced by contact tier",
  },
  {
    label: "One-time setup fee",
    memberley: "None",
    competitor: "None",
  },
  {
    label: "Payments",
    memberley: "Your own Stripe · 1–2 day payouts",
    competitor: "Personify Payments · 2.9% + 30¢",
  },
  {
    label: "Member portal embeds in the website you already have",
    memberley: true,
    competitor: "Widgets or hosted site",
  },
  {
    label: "White-label branding on portal & emails",
    memberley: true,
    competitor: null,
  },
  {
    label: "Built-in email broadcasts & member segments",
    memberley: true,
    competitor: true,
  },
  {
    label: "SMS broadcasts & one-to-one texts",
    memberley: true,
    competitor: null,
  },
  { label: "Online dues & auto-renewal", memberley: true, competitor: true },
  {
    label: "Guest passes & QR gate check-in",
    memberley: true,
    competitor: null,
  },
  {
    label: "Reservations (lanes / courts / rooms)",
    memberley: true,
    competitor: null,
  },
  {
    label: "Point of sale & snack bar",
    memberley: true,
    competitor: null,
  },
  {
    label: "Digital waivers with e-signature",
    memberley: true,
    competitor: null,
  },
  {
    label: "Classes, lessons & programs",
    memberley: true,
    competitor: "Event registration",
  },
  {
    label: "Mobile member experience",
    memberley: "Browser-based — nothing to install",
    competitor: "Member app",
  },
  {
    label: "Free white-glove migration",
    memberley: true,
    competitor: "Complimentary onboarding",
  },
];

const reasons = [
  {
    title: "Unlimited members — contacts aren't a meter",
    body: "Wild Apricot prices by the size of your database: every lapsed member, prospect, and newsletter subscriber counts toward your contact tier, and the bill steps up as the list grows. Memberley includes unlimited members on every plan, starting at $0/yr with a 3% payment fee.",
  },
  {
    title: "Built for the front gate, not just the database",
    body: "Wild Apricot is general-purpose membership software: directory, website, newsletters, events. Memberley runs the club itself — seasonal dues, guest passes that auto-charge, lane and court reservations, and QR check-in at the gate — out of the box.",
  },
  {
    title: "Your own Stripe — and your own brand",
    body: "Wild Apricot routes cards through its integrated Personify Payments at 2.9% + 30¢, and other processors cost extra. With Memberley you connect your own Stripe account: payouts typically reach your bank in 1–2 business days, and the portal and every email carry your club's branding.",
  },
  {
    title: "We move you over for free",
    body: "Export your Wild Apricot contacts, send them to us, and we import your roster, set up your branded portal, and have you live before registration opens next season. No spreadsheets, no downtime.",
  },
];

// Extras where Memberley goes further than Wild Apricot's published feature set.
const builtInExtras: {
  title: string;
  desc: string;
  icon: string;
  badge?: string;
}[] = [
  {
    title: "Gate check-in & guest passes",
    desc: "QR check-in at the front desk, with guest passes that auto-charge the member's card on file.",
    icon: '<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/>',
  },
  {
    title: "Facility reservations",
    desc: "Lanes, courts, rooms, and cabanas with booking rules, recurring blocks, and a calendar your members actually use.",
    icon: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>',
  },
  {
    title: "SMS member texts",
    desc: "Reach members where they actually reply: broadcasts and one-to-one texts, right alongside everything else.",
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    title: "Waivers & documents",
    desc: "E-sign reusable waiver templates with annual expiration and share a document library, exportable as signed PDFs.",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/>',
  },
  {
    title: "Point of sale & snack bar",
    desc: "Ring up concessions and pro-shop sales at the counter, charged to the card on file or paid on the spot.",
    icon: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  },
  {
    title: "Embedded white-label portal",
    desc: "Drop the full member portal into your own website, themed to your colors, fonts, and logo.",
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: "Family & household accounts",
    desc: "Link a household under one roof and keep billing and guest passes straight.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];

const faqs = [
  {
    q: "Is Memberley a good Wild Apricot alternative for pools and clubs?",
    a: "Yes — if your organization has a physical facility, Memberley is purpose-built for it: seasonal membership tiers, online dues with auto-renewal, guest passes that auto-charge at the gate, QR check-in, lane and court reservations, and waitlists. Wild Apricot is strong general membership software, but those club operations aren't part of its published feature set.",
  },
  {
    q: "How does pricing compare to Wild Apricot?",
    a: "Wild Apricot prices by contact-database size, starting at $66/month for a tier of just 100 contacts, and every prospect, lapsed member, and newsletter subscriber counts toward the tier. Memberley starts at $0/yr with unlimited members and a 3% payment fee — or a $500/yr Community plan with zero payment fees — and add-on modules are free for your entire first year. Standard Stripe processing fees apply, as with any provider.",
  },
  {
    q: "What counts as a contact in Wild Apricot?",
    a: "Everyone in the database — active members, lapsed members, event attendees, and newsletter subscribers all count toward your contact tier. A 350-family pool with spouses and a mailing list can outgrow a tier quickly. Memberley has no member or contact caps on any plan.",
  },
  {
    q: "Where does the money go when members pay?",
    a: "Into your own Stripe account. You connect Stripe in under 10 minutes, and dues, renewals, and guest fees typically deposit to your bank in 1–2 business days — no integrated processor in the middle. Wild Apricot's integrated Personify Payments charges 2.9% + 30¢ per transaction.",
  },
  {
    q: "Can we keep our existing club website?",
    a: "Yes. Memberley's member portal embeds into the site you already have, themed to match. Wild Apricot's strength is its hosted website builder — great if you want the vendor to run your site, unnecessary if you already have one you like.",
  },
  {
    q: "Do you work with Northern Virginia pools?",
    a: "Yes — Memberley is based in Northern Virginia and we'll happily meet your board in person to walk through setup and migration.",
  },
];
---

<Layout
  title="Wild Apricot Alternative for Pools & Clubs | Memberley"
  description="Looking for a Wild Apricot alternative? Memberley runs your club's dues, guest passes, reservations, and gate check-in — with unlimited members, payments to your own Stripe account, your branding, and free migration."
>
  <div class="min-h-dvh paper-light font-sans text-stone-900 antialiased">
    <SiteHeader />

    <!-- Hero -->
    <section class="site-header-offset hero-wash border-b border-stone-950/10">
      <div class="mx-auto grid max-w-[74rem] items-center gap-12 px-6 py-20 lg:grid-cols-[0.84fr_1.16fr] lg:px-8 lg:py-24">
        <div class="max-w-[60ch]">
          <div class={eyebrow}>§ Wild Apricot alternative</div>
          <h1
            class={`mt-5 max-w-[18ch] text-[clamp(2.5rem,4vw,3.5rem)] leading-[1] text-balance ${display} text-stone-900`}
          >
            The Wild Apricot alternative built for clubs with a front gate.
          </h1>
          <p
            class="mt-7 max-w-[54ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            Wild Apricot keeps a tidy membership list. Memberley runs the club
            itself — dues, guest passes, reservations, QR check-in at the gate —
            with <strong>unlimited members</strong>, payments into
            <strong>your</strong> Stripe account, and no per-contact pricing
            tiers.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class={`group inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.875rem] font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 ${primaryBtn}`}
            >
              Start 45-day free trial
              <span class="transition group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href="#compare"
              class={`inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.875rem] font-medium transition ${secondaryBtn}`}
            >
              See the comparison
            </a>
          </div>
          <p class="mt-6 font-mono text-[0.75rem] tracking-wide text-stone-600">
            Free migration off Wild Apricot · Unlimited members · 45-day trial,
            no card
          </p>
        </div>
        <ComparisonHeroVisual
          competitor="Wild Apricot"
          competitorLogo="/competitors/wild-apricot.svg"
          screenshot="/product/check-in.webp"
          screenshotAlt="Memberley front-desk check-in workspace"
        />
      </div>
    </section>

    <!-- Reasons -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>§ Why clubs switch</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Four reasons clubs move to Memberley.
          </h2>
        </div>
        <dl
          class="grid grid-cols-1 divide-y divide-stone-950/10 border-y border-stone-950/10 md:grid-cols-2 md:divide-x md:divide-y-0"
        >
          {
            reasons.map((r, i) => (
              <div
                class={`p-8 ${i >= 2 ? "md:border-t md:border-stone-950/10" : ""}`}
              >
                <dt class={`text-[1.375rem] ${display} text-stone-900`}>
                  {r.title}
                </dt>
                <dd class="mt-3 max-w-[50ch] text-[0.9375rem] leading-relaxed text-stone-600">
                  {r.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Head-to-head comparison -->
    <section id="compare" class="border-b border-stone-950/10 bg-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>§ Head to head</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Memberley vs. Wild Apricot.
          </h2>
        </div>

        <div
          class="overflow-x-auto rounded-lg border border-stone-950/15 bg-white"
        >
          <table class="w-full border-collapse text-left">
            <thead>
              <ComparisonTableHead
                competitor="Wild Apricot"
                competitorLogo="/competitors/wild-apricot.svg"
              />
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-stone-950/5 last:border-0">
                    <th class="p-3 align-middle text-[0.8125rem] font-medium text-stone-700 sm:p-4">
                      {row.label}
                    </th>
                    {[row.memberley, row.competitor].map((cell, i) => (
                      <td
                        class={`p-3 text-center align-middle sm:p-4 ${i === 0 ? "bg-brand-700/[0.04]" : ""}`}
                      >
                        {typeof cell === "string" ? (
                          <span class="text-[0.8125rem] text-stone-700">
                            {cell}
                          </span>
                        ) : cell === true ? (
                          <svg
                            class="mx-auto size-4 text-brand-700"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-label="Yes"
                          >
                            <path
                              d="M3 8.3l3 3 7-7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : cell === false ? (
                          <span
                            class="text-[0.875rem] text-stone-400"
                            aria-label="No"
                          >
                            ✕
                          </span>
                        ) : (
                          <span
                            class="text-stone-300"
                            aria-label="Not advertised"
                          >
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p
          class="mt-4 max-w-[75ch] font-mono text-[0.75rem] tracking-wide text-stone-500"
        >
          * Wild Apricot pricing &amp; features as published on wildapricot.com
          (2026). “—” means not advertised by Wild Apricot; verify current terms
          before relying on them.
        </p>

        <!-- Fair-play note -->
        <div
          class="mt-10 flex flex-col gap-3 rounded-lg border border-stone-950/15 bg-white p-6 md:flex-row md:gap-6"
        >
          <div
            class="font-mono text-[0.6875rem] tracking-wide text-stone-500 uppercase md:w-44 md:shrink-0"
          >
            Credit where due
          </div>
          <p class="text-[0.875rem] leading-relaxed text-stone-600">
            Wild Apricot is mature, widely used membership software — now part
            of Momentive Software — with a 60-day free trial, a hosted website
            builder, a member app, and nonprofit features like donations. If you're running
            a professional association or a nonprofit chapter, it's a credible
            choice. Memberley is for clubs with a physical facility — pools,
            swim &amp; tennis clubs, and HOAs — where dues, guest passes,
            reservations, and gate check-in need to work as one system.
          </p>
        </div>
      </div>
    </section>

    <!-- More built in -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>§ Beyond the basics</div>
          <h2
            class={`mt-5 max-w-[24ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Club operations that come built in.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            The parts of running a real facility that general membership
            software leaves to spreadsheets and clipboards.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-4">
          {
            builtInExtras.map((f) => (
              <div>
                <div class="mb-3 flex size-8 items-center justify-center rounded-sm bg-stone-100 text-brand-700 ring-1 ring-stone-950/10">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4"
                    aria-hidden="true"
                    set:html={f.icon}
                  />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[0.9375rem] font-semibold text-stone-900">
                    {f.title}
                  </span>
                  {f.badge && (
                    <span class="rounded-sm border border-brand-700/30 bg-brand-700/10 px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase">
                      {f.badge}
                    </span>
                  )}
                </div>
                <div class="mt-1.5 text-[0.8125rem] leading-relaxed text-stone-600">
                  {f.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>§ FAQ</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Switching questions, answered.
          </h2>
        </div>
        <dl class="divide-y divide-stone-950/10 border-y border-stone-950/10">
          {
            faqs.map((f) => (
              <div class="grid grid-cols-1 gap-3 py-8 md:grid-cols-12 md:gap-8">
                <dt class="text-[1.0625rem] font-semibold text-stone-900 md:col-span-5">
                  {f.q}
                </dt>
                <dd class="max-w-[60ch] text-[0.9375rem] leading-relaxed text-stone-600 md:col-span-7">
                  {f.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="max-w-[40ch]">
          <div
            class="font-mono text-[0.6875rem] font-medium tracking-wide text-brand-400 uppercase"
          >
            § Make the switch
          </div>
          <h2
            class={`mt-5 text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
          >
            Stop counting contacts. Start running the club.
          </h2>
          <p
            class="mt-6 max-w-[46ch] text-[1rem] leading-relaxed text-stone-400"
          >
            Start a 45-day free trial and see your club in Memberley in
            minutes, or send us your Wild Apricot export and we'll set
            everything up for you, free, before next season.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class="inline-flex items-center gap-2 rounded-sm bg-brand-700 px-5 py-3 text-[0.875rem] font-semibold text-white transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            >
              Start 45-day free trial →
            </a>
            <a
              href={DEMO_URL}
              class="inline-flex items-center gap-2 rounded-sm border border-stone-700 px-5 py-3 text-[0.875rem] font-medium text-stone-200 transition hover:bg-stone-800"
            >
              Explore the live demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>

  <!-- FAQ structured data for rich results -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>
