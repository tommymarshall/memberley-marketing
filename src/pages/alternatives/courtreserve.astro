---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComparisonHeroVisual from "../../components/ComparisonHeroVisual.astro";
import { DEMO_URL, SIGNUP_URL } from "../../config/site";

// ── Class tokens (inlined paper theme, matches index.astro) ──────────────────
const eyebrow =
  "font-mono text-[0.6875rem] font-medium tracking-wide text-brand-800 uppercase";
const display = "font-serif font-semibold tracking-tight";
const primaryBtn =
  "bg-stone-900 text-stone-50 shadow-btn hover:bg-stone-800 focus-visible:outline-brand-600";
const secondaryBtn =
  "border border-stone-950/15 bg-white text-stone-900 hover:border-stone-950/30 hover:bg-stone-100";

// ── Head-to-head ─────────────────────────────────────────────────────────────
// Competitor details as published on courtreserve.com (2026). Re-verify before
// publishing — comparative claims must stay truthful.
// Cell types: string = literal · true = ✓ · false = ✕ · null = — (not advertised).
type Cell = string | boolean | null;

const rows: { label: string; memberley: Cell; competitor: Cell }[] = [
  {
    label: "Focus",
    memberley: "Pools, courts & neighborhood communities",
    competitor: "Tennis, pickleball & padel",
  },
  {
    label: "Starting price",
    memberley: "$0/yr + 3% per payment — or $500/yr, no payment fees",
    competitor: "From $159/mo (annual billing, 8 courts)",
  },
  {
    label: "Payments",
    memberley: "Your own Stripe · 1–2 day payouts",
    competitor: "Stripe or SafeSave",
  },
  {
    label: "Email & SMS broadcasts",
    memberley: "Flat-priced module · 1,000 SMS/mo included",
    competitor: "Metered — 500 texts & 5,000 marketing emails/mo",
  },
  {
    label: "White-label branding on portal & emails",
    memberley: "$100/yr module",
    competitor: "Top tier only · $499 setup · 1-yr contract",
  },
  {
    label: "Member portal embeds in the website you already have",
    memberley: true,
    competitor: null,
  },
  { label: "One-time setup fee", memberley: "None", competitor: null },
  {
    label: "QuickBooks & Mailchimp integrations",
    memberley: true,
    competitor: null,
  },
  {
    label: "Digital waivers & document library",
    memberley: true,
    competitor: "Waivers only",
  },
  { label: "Installment payment plans", memberley: true, competitor: null },
  { label: "ACH bank payments for dues", memberley: true, competitor: null },
  { label: "Free white-glove migration", memberley: true, competitor: null },
  { label: "Classes, lessons & programs", memberley: true, competitor: true },
  { label: "Online dues & auto-renewal", memberley: true, competitor: true },
  {
    label: "Guest passes, check-in & waitlist",
    memberley: true,
    competitor: true,
  },
  {
    label: "Reservations (lanes / courts / rooms)",
    memberley: true,
    competitor: true,
  },
  { label: "POS inventory tracking", memberley: true, competitor: true },
];

const reasons = [
  {
    title: "Pool-first, not court-first",
    body: "CourtReserve is designed around court scheduling. Memberley is built around the way community clubs actually run: seasonal membership tiers, guest passes auto-charged at the gate, a front-desk line that moves, with courts, lanes, and rooms covered by the same reservations module.",
  },
  {
    title: "Flat-priced comms, not metered",
    body: "CourtReserve meters broadcasts at 500 texts and 5,000 marketing emails a month, then you pay per bundle. Memberley's Communications module is $150/yr flat with 1,000 SMS a month included and unlimited email campaigns.",
  },
  {
    title: "Your brand isn't a top-tier perk",
    body: "CourtReserve gates its branded club experience to the top tier, with a $499 setup fee and a one-year contract. Memberley's Branded Site & Embed module is $100/yr — no setup fee, no contract — and covers the portal, sign-in pages, and every email.",
  },
  {
    title: "Pricing that fits a seasonal club",
    body: "From $159 a month, year-round, adds up fast for a pool that's open fourteen weeks. Memberley starts at $0/yr with a 3% payment fee — or $500/yr with none — and you turn modules on only when your club needs them.",
  },
];

// Extras where Memberley goes further for pools & community clubs.
const builtInExtras = [
  {
    title: "Guest-pass auto-charge",
    desc: "Passes deducted at the gate and charged automatically when a member runs out.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/>',
  },
  {
    title: "QR-code check-in",
    desc: "Members scan in at the front gate — no kiosk hardware, no app install.",
    icon: '<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/>',
  },
  {
    title: "Family & household accounts",
    desc: "Link a household under one roof and keep billing and guest passes straight.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    title: "Waivers & documents",
    desc: "E-sign reusable waiver templates and share a document library, exportable as signed PDFs.",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/>',
  },
  {
    title: "QuickBooks & Mailchimp",
    desc: "Native sync of dues and members into the accounting and email tools you already use.",
    icon: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>',
  },
  {
    title: "Embedded white-label portal",
    desc: "Drop the full member portal into your own website, themed to your colors, fonts, and logo.",
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: "ACH & installment plans",
    desc: "Members pay dues by bank transfer or on a payment plan, with autopay and automatic late fees built in.",
    icon: '<line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>',
  },
];

const faqs = [
  {
    q: "Is Memberley a good CourtReserve alternative?",
    a: "It depends on what you run. If you're a dedicated tennis, pickleball, or padel operation, CourtReserve's court scheduling is deep and purpose-built. If you're a pool, swim & tennis club, or HOA where courts are one amenity among many, Memberley is built around your actual season: memberships and dues, guest passes, front-gate check-in, and reservations for courts, lanes, and rooms together.",
  },
  {
    q: "How does pricing compare to CourtReserve?",
    a: "CourtReserve publishes plans from $159/month on annual billing for up to 8 courts, billed year-round. Memberley starts at $0/yr with unlimited members and a 3% payment fee — or a $500/yr Community plan with zero payment fees — plus flat-priced add-on modules ($100–$250/yr) you enable only if you need them.",
  },
  {
    q: "Are texts and emails metered?",
    a: "Not with Memberley. The Communications module is $150/yr flat and includes 1,000 SMS a month with unlimited email campaigns; if you need more texts in a busy month, top-ups are available in 1,000-message packs. CourtReserve's published plans meter broadcasts at 500 texts and 5,000 marketing emails a month, then charge per bundle.",
  },
  {
    q: "Can we still run court reservations on Memberley?",
    a: "Yes — the Facilities & Reservations module covers courts, lanes, and rooms with operating hours, booking slots, and conflict checks. Courts are a first-class amenity; they're just not the only thing the product is organized around.",
  },
  {
    q: "Do you offer white-label branding?",
    a: "Yes. The Branded Site & Embed module ($100/yr) applies your logo, colors, and typography across the member portal, sign-in pages, and emails, and lets you embed the portal in the website you already have — no setup fee and no annual contract.",
  },
  {
    q: "Do you work with Northern Virginia clubs?",
    a: "Yes — Memberley is based in Northern Virginia and we'll meet your board in person to walk through setup and migration. Migration is free: send us your current roster and we'll have you live before next season.",
  },
];
---

<Layout
  title="CourtReserve Alternative for Pools & Community Clubs | Memberley"
  description="Looking for a CourtReserve alternative for a pool or community club? Memberley is pool-first — seasonal memberships, guest passes, front-gate check-in, and court reservations — with flat-priced modules instead of metered SMS and email."
>
  <div class="min-h-dvh paper-light font-sans text-stone-900 antialiased">
    <SiteHeader />

    <!-- Hero -->
    <section class="hero-wash border-b border-stone-950/10">
      <div class="mx-auto grid max-w-[74rem] items-center gap-12 px-6 py-20 lg:grid-cols-[0.84fr_1.16fr] lg:px-8 lg:py-24">
        <div class="max-w-[60ch]">
          <div class={eyebrow}>§ CourtReserve alternative</div>
          <h1
            class={`mt-5 max-w-[18ch] text-[clamp(2.5rem,4vw,3.5rem)] leading-[1] text-balance ${display} text-stone-900`}
          >
            The pool-first CourtReserve alternative.
          </h1>
          <p
            class="mt-7 max-w-[54ch] text-[1.0625rem] leading-relaxed text-pretty text-stone-600"
          >
            Courts covered, of course. But Memberley is organized around the
            rest of your club too: seasonal memberships, guest passes
            auto-charged at the gate, front-desk check-in, and dues that settle
            to <strong>your</strong> Stripe account.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class={`group inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.875rem] font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 ${primaryBtn}`}
            >
              Start 45-day free trial
              <span class="transition group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href="#compare"
              class={`inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.875rem] font-medium transition ${secondaryBtn}`}
            >
              See the comparison
            </a>
          </div>
          <p
            class="mt-6 max-w-[75ch] font-mono text-[0.75rem] tracking-wide text-stone-600"
          >
            Free migration · No setup fee · 45-day trial, no card
          </p>
        </div>
        <ComparisonHeroVisual
          competitor="CourtReserve"
          competitorLogo="/competitors/courtreserve.svg"
          screenshot="/product/reservations.webp"
          screenshotAlt="Memberley reservations workspace"
        />
      </div>
    </section>

    <!-- Reasons -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>§ Why clubs switch</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Four reasons clubs move to Memberley.
          </h2>
        </div>
        <dl
          class="grid grid-cols-1 divide-y divide-stone-950/10 border-y border-stone-950/10 md:grid-cols-2 md:divide-x md:divide-y-0"
        >
          {
            reasons.map((r, i) => (
              <div
                class={`p-8 ${i >= 2 ? "md:border-t md:border-stone-950/10" : ""}`}
              >
                <dt class={`text-[1.375rem] ${display} text-stone-900`}>
                  {r.title}
                </dt>
                <dd class="mt-3 max-w-[50ch] text-[0.9375rem] leading-relaxed text-stone-600">
                  {r.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Head-to-head comparison -->
    <section id="compare" class="border-b border-stone-950/10 bg-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>§ Head to head</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Memberley vs. CourtReserve.
          </h2>
        </div>

        <div
          class="overflow-x-auto rounded-lg bg-white shadow-paper ring-1 ring-stone-950/5"
        >
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-stone-950/10 bg-stone-100">
                <th class="w-[38%] p-3 sm:w-[44%] sm:p-4"></th>
                <th
                  class="bg-brand-700/[0.06] p-3 text-center sm:p-4 text-[0.8125rem] font-semibold text-brand-800"
                  >Memberley</th
                >
                <th
                  class="p-3 text-center text-[0.8125rem] font-semibold text-stone-700 sm:p-4"
                  >CourtReserve</th
                >
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-stone-950/5 last:border-0">
                    <th class="p-3 align-middle text-[0.8125rem] font-medium text-stone-700 sm:p-4">
                      {row.label}
                    </th>
                    {[row.memberley, row.competitor].map((cell, i) => (
                      <td
                        class={`p-3 text-center align-middle sm:p-4 ${i === 0 ? "bg-brand-700/[0.04]" : ""}`}
                      >
                        {typeof cell === "string" ? (
                          <span class="text-[0.8125rem] text-stone-700">
                            {cell}
                          </span>
                        ) : cell === true ? (
                          <svg
                            class="mx-auto size-4 text-brand-700"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-label="Yes"
                          >
                            <path
                              d="M3 8.3l3 3 7-7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : cell === false ? (
                          <span
                            class="text-[0.875rem] text-stone-400"
                            aria-label="No"
                          >
                            ✕
                          </span>
                        ) : (
                          <span
                            class="text-stone-300"
                            aria-label="Not advertised"
                          >
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p
          class="mt-4 max-w-[75ch] font-mono text-[0.75rem] tracking-wide text-stone-500"
        >
          * CourtReserve pricing &amp; features as published on courtreserve.com
          (2026). “—” means not advertised by CourtReserve; verify current terms
          before relying on them.
        </p>

        <!-- Fair-play note -->
        <div
          class="mt-10 flex flex-col gap-3 rounded-lg bg-white p-6 ring-1 ring-stone-950/10 md:flex-row md:gap-6"
        >
          <div
            class="font-mono text-[0.6875rem] tracking-wide text-stone-500 uppercase md:w-44 md:shrink-0"
          >
            Credit where due
          </div>
          <p class="text-[0.875rem] leading-relaxed text-stone-600">
            CourtReserve is excellent at what it's built for — deep court
            scheduling, leagues, and programming for tennis, pickleball, and
            padel operations. If courts are your whole business, it's a strong
            choice. Memberley is for pools and community clubs where courts are
            one amenity among many.
          </p>
        </div>
      </div>
    </section>

    <!-- More built in -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-14 max-w-[44ch]">
          <div class={eyebrow}>§ Beyond the courts</div>
          <h2
            class={`mt-5 max-w-[24ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            The rest of the club, built in.
          </h2>
          <p
            class="mt-4 text-[1rem] leading-relaxed text-pretty text-stone-600"
          >
            The parts of running a community club that court software leaves to
            spreadsheets.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-4">
          {
            builtInExtras.map((f) => (
              <div>
                <div class="mb-3 flex size-8 items-center justify-center rounded-sm bg-stone-100 text-brand-700 ring-1 ring-stone-950/10">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4"
                    aria-hidden="true"
                    set:html={f.icon}
                  />
                </div>
                <div class="text-[0.9375rem] font-semibold text-stone-900">
                  {f.title}
                </div>
                <div class="mt-1.5 text-[0.8125rem] leading-relaxed text-stone-600">
                  {f.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-stone-950/10">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="mb-12 max-w-[44ch]">
          <div class={eyebrow}>§ FAQ</div>
          <h2
            class={`mt-5 max-w-[22ch] text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-900`}
          >
            Switching questions, answered.
          </h2>
        </div>
        <dl class="divide-y divide-stone-950/10 border-y border-stone-950/10">
          {
            faqs.map((f) => (
              <div class="grid grid-cols-1 gap-3 py-8 md:grid-cols-12 md:gap-8">
                <dt class="text-[1.0625rem] font-semibold text-stone-900 md:col-span-5">
                  {f.q}
                </dt>
                <dd class="max-w-[60ch] text-[0.9375rem] leading-relaxed text-stone-600 md:col-span-7">
                  {f.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="paper-dark text-stone-50">
      <div class="mx-auto max-w-[74rem] px-6 py-24 lg:px-8">
        <div class="max-w-[40ch]">
          <div
            class="font-mono text-[0.6875rem] font-medium tracking-wide text-brand-400 uppercase"
          >
            § Make the switch
          </div>
          <h2
            class={`mt-5 text-[clamp(2.25rem,4vw,3.25rem)] leading-[1.05] text-balance ${display} text-stone-50`}
          >
            Run the whole club, not just the courts.
          </h2>
          <p
            class="mt-6 max-w-[46ch] text-[1rem] leading-relaxed text-stone-400"
          >
            Start a 45-day free trial and see your club in Memberley in minutes, or
            send us your current roster and we'll set everything up for you,
            free, before next season.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href={SIGNUP_URL}
              class="inline-flex items-center gap-2 rounded-sm bg-brand-700 px-5 py-3 text-[0.875rem] font-semibold text-white shadow-btn transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            >
              Start 45-day free trial →
            </a>
            <a
              href={DEMO_URL}
              class="inline-flex items-center gap-2 rounded-sm border border-stone-700 px-5 py-3 text-[0.875rem] font-medium text-stone-200 transition hover:bg-stone-800"
            >
              Explore the live demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>

  <!-- FAQ structured data for rich results -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>
